<script>
/* ══════════════════════════════════════════════
   ZONE CONFIG
══════════════════════════════════════════════ */
const ZONE_CFG = {
  ZEU:  { color:'#3B82F6', label:'Zona Eixo Urbano',    desc:'Eixo de estruturação da transformação urbana – alta densidade, CA máx 4' },
  ZM:   { color:'#22C55E', label:'Zona Mista',           desc:'Uso misto residencial/comercial de alta densidade' },
  ZEIS: { color:'#A855F7', label:'ZEIS',                 desc:'Zona Especial de Interesse Social – CA máx 2.5' },
  ZC:   { color:'#F59E0B', label:'Zona Central',         desc:'Alta densidade comercial – CA máx 2' },
  ZR:   { color:'#84CC16', label:'Zona Residencial',     desc:'Baixa densidade – CA máx 1' },
};
const ZONE_CA  = { ZEU:4, ZM:2, ZEIS:2.5, ZC:2, ZR:1 };
const ZONE_GAB = { ZEU:'N.A.', ZM:'28m', ZEIS:'N.A.', ZC:'24m', ZR:'12m' };
const ZONE_REC = { ZEU:{f:5,l:1.5}, ZM:{f:5,l:1.5}, ZEIS:{f:3,l:1.5}, ZC:{f:4,l:1.5}, ZR:{f:5,l:2} };

/* ══════════════════════════════════════════════
   HELPERS
══════════════════════════════════════════════ */
const fmt    = v => 'R$ ' + Math.round(v).toLocaleString('pt-BR');
const fmtNum = v => Math.round(v).toLocaleString('pt-BR');

function polyArea(coords){
  let a=0;
  for(let i=0,n=coords.length-1;i<n;i++) a+=coords[i][0]*coords[i+1][1]-coords[i+1][0]*coords[i][1];
  a=Math.abs(a)/2;
  const lat=coords.reduce((s,c)=>s+c[1],0)/coords.length;
  return Math.round(a*111320*(111320*Math.cos(lat*Math.PI/180)));
}

function assignZone(fid){
  const zones=['ZEU','ZEU','ZEU','ZM','ZM','ZEIS','ZC','ZR'];
  return zones[Math.abs(fid)%zones.length];
}

function isMobile(){ return window.innerWidth<=640; }

/* ══════════════════════════════════════════════
   CALC
══════════════════════════════════════════════ */
let slEfic=80, slMedia=65, slCusto=3500, slVenda=12000, slTerra=10000;

function calc(lot){
  const ac=lot.area*lot.ca, av=ac*(slEfic/100);
  const unds=Math.floor(av/slMedia), pavs=Math.ceil(ac/lot.area);
  const vgv=av*slVenda, obra=ac*slCusto, terr=lot.area*slTerra;
  const lucro=vgv-obra, lucroLiq=lucro-terr;
  const roi=obra>0?(lucro/obra)*100:0;
  const roiT=(obra+terr)>0?(lucroLiq/(obra+terr))*100:0;
  const marg=vgv>0?(lucro/vgv)*100:0;
  return {ac,av,unds,pavs,vgv,obra,terr,lucro,lucroLiq,roi,roiT,marg};
}

/* ══════════════════════════════════════════════
   OVERPASS
══════════════════════════════════════════════ */
const featCache=new Map();
let loadTimer=null, lastBbox='', mapReady=false;

function scheduleLoad(){ clearTimeout(loadTimer); loadTimer=setTimeout(loadBuildings,700); }

/* Classify feature type and label for display */
function classifyTerrain(tags){
  const b=tags.building||'', lu=tags.landuse||'', am=tags.amenity||'';
  if(am==='parking')           return { tipo:'Estacionamento', label: tags.name||'Estacionamento' };
  if(lu==='vacant')            return { tipo:'Terreno Vago',   label: tags.name||'Terreno Vago' };
  if(lu==='brownfield')        return { tipo:'Área p/ Requalificação', label: tags.name||'Área Requalificação' };
  if(lu==='greenfield')        return { tipo:'Terreno Verde',  label: tags.name||'Área Verde' };
  if(lu==='construction')      return { tipo:'Em Construção',  label: tags.name||'Em Construção' };
  if(lu==='farmland'||lu==='grass'||lu==='meadow'||lu==='allotments')
                               return { tipo:'Área Rural/Pasto', label: tags.name||'Área Rural' };
  if(b==='house'||b==='detached'||b==='terrace'||b==='bungalow')
                               return { tipo:'Residencial Baixo Gabarito', label: tags.name||tags['addr:street']||'Casa Unifamiliar' };
  if(b==='industrial'||b==='warehouse')
                               return { tipo:'Industrial / Galpão', label: tags.name||'Galpão Industrial' };
  if(b==='commercial'||b==='retail'||b==='kiosk')
                               return { tipo:'Comercial Baixo Gabarito', label: tags.name||'Imóvel Comercial' };
  if(b==='garage'||b==='shed'||b==='hut')
                               return { tipo:'Garagem / Depósito', label: tags.name||'Garagem' };
  return { tipo:'Terreno / Baixo Gabarito', label: tags.name||tags['addr:street']||null };
}

async function loadBuildings(){
  if(!mapReady) return;
  if(map.getZoom()<14){ setHint('Zoom ≥ 14 para carregar terrenos'); return; }
  const b=map.getBounds();
  const bbox=`${b.getSouth().toFixed(5)},${b.getWest().toFixed(5)},${b.getNorth().toFixed(5)},${b.getEast().toFixed(5)}`;
  if(bbox===lastBbox) return;
  lastBbox=bbox;
  setHint('⟳ Carregando terrenos...', true);
  // Query: surface parking + vacant land + low-density buildings (candidates for redevelopment)
  const q=`[out:json][timeout:25];(
    way["amenity"="parking"]["parking"!~"multi.storey|underground"](${bbox});
    way["landuse"~"^(vacant|brownfield|greenfield|farmland|grass|meadow|allotments|construction)$"](${bbox});
    way["building"~"^(house|detached|terrace|bungalow|shed|hut|garage|industrial|warehouse|commercial|retail|yes)$"](${bbox});
  );out geom;`;
  try{
    const res=await fetch(`https://overpass-api.de/api/interpreter?data=${encodeURIComponent(q)}`);
    if(!res.ok) throw new Error('HTTP '+res.status);
    const data=await res.json();
    const features=[], seen=new Set();
    for(const el of data.elements){
      if(el.type!=='way'||!el.geometry||el.geometry.length<3) continue;
      if(seen.has(el.id)) continue; seen.add(el.id);
      let coords=el.geometry.map(p=>[p.lon,p.lat]);
      if(coords[0][0]!==coords[coords.length-1][0]) coords.push([...coords[0]]);
      const area=Math.max(polyArea(coords),20);
      // Skip huge polygons (likely landuse regions, not individual plots)
      if(area>20000) continue;
      const tags=el.tags||{};
      const zone=assignZone(el.id);
      const {tipo, label}=classifyTerrain(tags);
      const addr=(`${tags['addr:street']||''} ${tags['addr:housenumber']||''}`).trim()||null;
      featCache.set(el.id,{
        id:el.id, area, zone, ca:ZONE_CA[zone]||4, maxHeight:48,
        gab:ZONE_GAB[zone]||'N.A.', rec:ZONE_REC[zone]||{f:5,l:1.5},
        label: label||`Terreno ${String(el.id).slice(-5)}`,
        address: addr||null,
        bairro: tags['addr:suburb']||tags['addr:city_district']||'São Paulo',
        tipo
      });
      features.push({ type:'Feature', id:el.id, properties:{fid:el.id,zone}, geometry:{type:'Polygon',coordinates:[coords]} });
    }
    map.getSource('buildings').setData({type:'FeatureCollection',features});
    document.getElementById('cb-num').textContent=features.length||'0';
    if(!selFids.size) setHint(features.length?`${features.length} terrenos — toque para analisar`:'Sem terrenos nessa área');
  }catch(err){
    console.warn('[UrbanAI]',err);
    setHint('Erro ao carregar. Verifique a conexão.');
  }
}

/* ══════════════════════════════════════════════
   MAP INIT
══════════════════════════════════════════════ */
let map, hovId=null, is3d=true;

function initMap(){
  map=new maplibregl.Map({
    container:'map',
    style:'https://tiles.openfreemap.org/styles/liberty',
    center:[-46.6543,-23.5616],
    zoom:16, pitch:60, bearing:-18,
    attributionControl:false
  });
  map.addControl(new maplibregl.NavigationControl({showCompass:true,showZoom:true,visualizePitch:true}),'bottom-right');
  map.addControl(new maplibregl.AttributionControl({compact:true}),'bottom-left');

  map.on('load',()=>{
    mapReady=true;
    map.addSource('buildings',{type:'geojson',data:{type:'FeatureCollection',features:[]}});

    map.addLayer({id:'bld-zone',type:'fill',source:'buildings',paint:{
      'fill-color':['match',['get','zone'],'ZEU','#1d3a6e','ZM','#1a4a2a','ZEIS','#3a1a5e','ZC','#4a3a0a','#1a2e22'],
      'fill-opacity':0.38
    }});
    map.addLayer({id:'bld-zone-line',type:'line',source:'buildings',paint:{
      'line-color':['match',['get','zone'],'ZEU','#3B82F6','ZM','#22C55E','ZEIS','#A855F7','ZC','#F59E0B','#3a6a50'],
      'line-width':1,'line-opacity':0.55
    }});
    map.addLayer({id:'bld-hover',type:'fill',source:'buildings',paint:{
      'fill-color':'#60A5FA',
      'fill-opacity':['case',['boolean',['feature-state','hover'],false],0.3,0]
    }});
    map.addLayer({id:'bld-sel',type:'fill',source:'buildings',paint:{
      'fill-color':'#1d4ed8',
      'fill-opacity':['case',['boolean',['feature-state','selected'],false],0.82,0]
    }});
    map.addLayer({id:'bld-sel-line',type:'line',source:'buildings',paint:{
      'line-color':['case',['boolean',['feature-state','selected'],false],'#93C5FD',['boolean',['feature-state','hover'],false],'#60A5FA','rgba(0,0,0,0)'],
      'line-width':['case',['boolean',['feature-state','selected'],false],2.5,1.5]
    }});
    // Hit target — invisible, topmost, captures all clicks
    map.addLayer({id:'bld-hit',type:'fill',source:'buildings',paint:{'fill-color':'rgba(0,0,0,0)','fill-opacity':0.001}});

    map.on('click','bld-hit',e=>{
      if(!e.features?.length) return;
      e.originalEvent._hitBuilding=true;
      toggleBuilding(Number(e.features[0].properties.fid), e.features[0]);
    });
    map.on('click',e=>{ if(!e.originalEvent._hitBuilding) deselectAll(); });

    map.on('mousemove','bld-hit',e=>{
      if(!e.features?.length){ clearHov(); return; }
      const id=Number(e.features[0].properties.fid);
      if(hovId!==null&&hovId!==id) map.setFeatureState({source:'buildings',id:hovId},{hover:false});
      hovId=id;
      map.setFeatureState({source:'buildings',id:hovId},{hover:true});
      map.getCanvas().style.cursor='pointer';
    });
    map.on('mouseleave','bld-hit',clearHov);
    map.on('moveend',scheduleLoad);
    map.on('zoomend',scheduleLoad);
    loadBuildings();
  });
}

function clearHov(){
  if(hovId!==null) map.setFeatureState({source:'buildings',id:hovId},{hover:false});
  hovId=null; map.getCanvas().style.cursor='';
}

/* ══════════════════════════════════════════════
   MULTI-SELECT
══════════════════════════════════════════════ */
const selFids=new Set();
let lastSelFid=null, currentLot=null, barCh=null, pieCh=null;

function ensureInCache(fid, feat){
  if(!featCache.has(fid)){
    const zone=feat?.properties?.zone||'ZEU';
    featCache.set(fid,{id:fid,area:500,zone,ca:ZONE_CA[zone]||4,maxHeight:48,
      gab:ZONE_GAB[zone]||'N.A.',rec:ZONE_REC[zone]||{f:5,l:1.5},
      label:`Terreno ${String(fid).slice(-5)}`,address:null,bairro:'São Paulo',tipo:'Terreno'});
  }
}

function buildAggregateLot(){
  const lots=[...selFids].map(fid=>featCache.get(fid)).filter(Boolean);
  if(!lots.length) return null;
  if(lots.length===1) return lots[0];
  const totalArea=lots.reduce((s,l)=>s+l.area,0);
  const avgCA=lots.reduce((s,l)=>s+l.ca,0)/lots.length;
  const zones=[...new Set(lots.map(l=>l.zone))];
  const pz=zones[0];
  return {id:'aggregate',area:totalArea,zone:pz,ca:+avgCA.toFixed(2),
    maxHeight:Math.max(...lots.map(l=>l.maxHeight)),
    gab:ZONE_GAB[pz]||'N.A.',rec:ZONE_REC[pz]||{f:5,l:1.5},
    label:`${lots.length} Lotes — Análise Agregada`,
    address:null,bairro:'São Paulo',tipo:'Misto',zoneList:zones};
}

function toggleBuilding(fid, feat){
  ensureInCache(fid, feat);
  if(selFids.has(fid)){
    selFids.delete(fid);
    map.setFeatureState({source:'buildings',id:fid},{selected:false});
    if(lastSelFid===fid) lastSelFid=selFids.size>0?[...selFids].at(-1):null;
  } else {
    selFids.add(fid);
    map.setFeatureState({source:'buildings',id:fid},{selected:true});
    lastSelFid=fid;
  }
  refreshPanel();
}

function deselectAll(){
  if(!selFids.size) return;
  selFids.forEach(fid=>map.setFeatureState({source:'buildings',id:fid},{selected:false}));
  selFids.clear(); lastSelFid=null; currentLot=null;
  document.getElementById('empty-state').style.display='flex';
  document.getElementById('lot-detail').style.display='none';
  document.getElementById('hint').classList.remove('hide');
  updateSelBadge();
  if(isMobile()) setSheetPeek();
}

function refreshPanel(){
  updateSelBadge();
  if(!selFids.size){
    document.getElementById('empty-state').style.display='flex';
    document.getElementById('lot-detail').style.display='none';
    document.getElementById('hint').classList.remove('hide');
    if(isMobile()) setSheetPeek();
    return;
  }
  currentLot=buildAggregateLot();
  if(!currentLot) return;
  const isMulti=selFids.size>1;

  document.getElementById('lh-title').textContent=currentLot.label;
  if(isMulti){
    document.getElementById('lh-addr').textContent='📍 Área total: '+fmtNum(currentLot.area)+' m²';
    document.getElementById('lh-tipo').textContent='🏛 Análise combinada — '+selFids.size+' lotes';
  } else {
    const l=currentLot;
    document.getElementById('lh-addr').textContent=l.address?'📍 '+l.address+' · '+l.bairro:'📍 '+l.bairro+', SP';
    document.getElementById('lh-tipo').textContent='🏛 '+l.tipo;
  }
  document.getElementById('lkv-area').textContent=fmtNum(currentLot.area)+' m²';
  document.getElementById('lkv-preco').textContent='R$'+fmtNum(slTerra)+'/m²';
  document.getElementById('lkv-ca').textContent=currentLot.ca+'×';
  const zb=document.getElementById('lh-zone');
  if(isMulti&&currentLot.zoneList?.length>1){zb.textContent=currentLot.zoneList.join('+');zb.style.background='#475569';}
  else{zb.textContent=currentLot.zone;zb.style.background=ZONE_CFG[currentLot.zone]?.color||'#3B82F6';}
  const cb=document.getElementById('close-btn');
  if(cb) cb.textContent=isMulti?`✕ Limpar (${selFids.size})`:'✕ fechar';

  document.getElementById('empty-state').style.display='none';
  document.getElementById('lot-detail').style.display='flex';
  document.getElementById('hint').classList.add('hide');

  if(isMobile()) setSheetOpen();

  updateAnalise(); updateFinanceiro(); updateDados();
}

function updateSelBadge(){
  const sub=document.getElementById('cb-sub');
  if(sub) sub.textContent=selFids.size>0
    ?`${selFids.size} selecionado${selFids.size>1?'s':''} — toque p/ toggle`
    :'toque para analisar';
  const hl=document.getElementById('handle-label');
  if(hl) hl.textContent=selFids.size>0
    ?(selFids.size===1?'1 lote selecionado — arraste para ver':selFids.size+' lotes — arraste para ver')
    :'🗺️ Toque para explorar';
}

/* ══════════════════════════════════════════════
   MOBILE SHEET
══════════════════════════════════════════════ */
let sheetOpen=false;

function setSheetOpen(){
  const p=document.getElementById('panel');
  p.classList.add('sheet-open'); p.classList.remove('sheet-peek');
  sheetOpen=true;
}
function setSheetPeek(){
  const p=document.getElementById('panel');
  p.classList.remove('sheet-open'); p.classList.add('sheet-peek');
  sheetOpen=false;
}
function toggleSheet(){
  if(sheetOpen) setSheetPeek(); else setSheetOpen();
}

/* Swipe-to-close on mobile panel */
(()=>{
  let startY=0, startOpen=false;
  const panel=()=>document.getElementById('panel');
  document.addEventListener('touchstart',e=>{
    const p=panel(); if(!p.contains(e.target)) return;
    startY=e.touches[0].clientY; startOpen=sheetOpen;
  },{passive:true});
  document.addEventListener('touchend',e=>{
    const p=panel(); if(!p.contains(e.target)) return;
    const dy=e.changedTouches[0].clientY-startY;
    if(dy>60&&startOpen) setSheetPeek();
    else if(dy<-60&&!startOpen) setSheetOpen();
  },{passive:true});
})();

/* ══════════════════════════════════════════════
   TAB UPDATES
══════════════════════════════════════════════ */
function onSlider(){
  slEfic  = +document.getElementById('sl-efic').value;
  slMedia = +document.getElementById('sl-media').value;
  slCusto = +document.getElementById('sl-custo').value;
  slVenda = +document.getElementById('sl-venda').value;
  slTerra = +document.getElementById('sl-terra').value;
  document.getElementById('sv-efic').textContent  = slEfic+'%';
  document.getElementById('sv-media').textContent = slMedia+' m²';
  document.getElementById('sv-custo').textContent = 'R$ '+fmtNum(slCusto);
  document.getElementById('sv-venda').textContent = 'R$ '+fmtNum(slVenda);
  document.getElementById('sv-terra').textContent = 'R$ '+fmtNum(slTerra);
  document.getElementById('lkv-preco').textContent= 'R$'+fmtNum(slTerra)+'/m²';
  if(selFids.size){ updateAnalise(); updateFinanceiro(); }
}

function updateAnalise(){
  if(!currentLot) return;
  const lot=currentLot, c=calc(lot);
  document.getElementById('kc-construida').textContent=fmtNum(c.ac)+' m²';
  document.getElementById('kcs-construida').textContent='CA '+lot.ca+'× '+fmtNum(lot.area)+'m²';
  document.getElementById('kc-vendavel').textContent=fmtNum(c.av)+' m²';
  document.getElementById('kcs-vendavel').textContent=slEfic+'% eficiência';
  document.getElementById('kc-unidades').textContent=c.unds;
  document.getElementById('kcs-unidades').textContent='média '+slMedia+'m²/unid.';
  document.getElementById('kc-pavimentos').textContent=c.pavs+' pav.';
  document.getElementById('kcs-pavimentos').textContent='até '+lot.maxHeight+'m gabarito';
  document.getElementById('f1').innerHTML=`<span class="dim">Área construída</span> = ${fmtNum(lot.area)}m² × ${lot.ca} = <b style="color:#3B82F6">${fmtNum(c.ac)}m²</b>`;
  document.getElementById('f2').innerHTML=`<span class="dim">Área vendável</span> = ${fmtNum(c.ac)}m² × ${slEfic}% = <b style="color:#22C55E">${fmtNum(c.av)}m²</b>`;
  document.getElementById('f3').innerHTML=`<span class="dim">Unidades</span> = ${fmtNum(c.av)} ÷ ${slMedia}m² = <b style="color:#F59E0B">${c.unds} unid.</b>`;
}

function updateFinanceiro(){
  if(!currentLot) return;
  const lot=currentLot, c=calc(lot);
  const rcol=c.roi>=20?'#22C55E':c.roi>=10?'#F59E0B':'#EF4444';
  const rtcol=c.roiT>=15?'#22C55E':c.roiT>=8?'#F59E0B':'#EF4444';
  const lcol=c.lucroLiq>=0?'#22C55E':'#EF4444';
  document.getElementById('fi-vgv').textContent=fmt(c.vgv);
  document.getElementById('fi-custo').textContent=fmt(c.obra);
  document.getElementById('fi-custo-sub').textContent='R$'+fmtNum(slCusto)+'/m²';
  document.getElementById('fi-terra').textContent=fmt(c.terr);
  const fts=document.getElementById('fi-terra-sub');
  if(fts) fts.textContent='R$'+fmtNum(slTerra)+'/m²';
  document.getElementById('fi-lucro').textContent=fmt(c.lucroLiq);
  document.getElementById('fi-lucro').style.color=lcol;
  document.getElementById('fi-roi').textContent=c.roi.toFixed(1)+'%';
  document.getElementById('fi-roi').style.color=rcol;
  document.getElementById('fi-roi-total').textContent=c.roiT.toFixed(1)+'%';
  document.getElementById('fi-roi-total').style.color=rtcol;

  const barCtx=document.getElementById('bar-chart').getContext('2d');
  if(barCh) barCh.destroy();
  barCh=new Chart(barCtx,{type:'bar',data:{
    labels:['VGV','Custo Obra','Terreno','Lucro Líq.'],
    datasets:[{data:[c.vgv/1e6,c.obra/1e6,c.terr/1e6,c.lucroLiq/1e6],
      backgroundColor:['#22C55E','#F59E0B','#F97316',c.lucroLiq>=0?'#3B82F6':'#EF4444'],borderRadius:4}]
  },options:{responsive:true,plugins:{legend:{display:false}},scales:{
    x:{ticks:{color:'#6B7FA3',font:{size:10}},grid:{color:'#1E3050'}},
    y:{ticks:{color:'#6B7FA3',font:{size:10},callback:v=>'R$'+v.toFixed(1)+'M'},grid:{color:'#1E3050'}}
  }}});

  const pieCtx=document.getElementById('pie-chart').getContext('2d');
  if(pieCh) pieCh.destroy();
  pieCh=new Chart(pieCtx,{type:'doughnut',data:{
    labels:['Custo Obra','Terreno','Lucro Bruto'],
    datasets:[{data:[c.obra/1e6,c.terr/1e6,Math.max(c.lucro/1e6,0)],backgroundColor:['#F59E0B','#F97316','#22C55E'],borderWidth:0}]
  },options:{responsive:true,plugins:{legend:{labels:{color:'#6B7FA3',font:{size:10}}}}}});

  const verd=document.getElementById('verdict'),ok=c.roiT>=12;
  verd.style.background=ok?'rgba(34,197,94,.08)':'rgba(239,68,68,.08)';
  document.getElementById('vd-title').style.color=ok?'#22C55E':'#EF4444';
  document.getElementById('vd-title').textContent=ok?'✅ Viável — ROI acima da meta':'⚠️ Atenção — ROI abaixo da meta';
  document.getElementById('vd-desc').textContent=ok
    ?`Margem de ${c.marg.toFixed(1)}% sobre VGV. Retorno total de ${c.roiT.toFixed(1)}% sobre investimento.`
    :`Margem de ${c.marg.toFixed(1)}% sobre VGV. Ajuste o valor de venda ou reduza custos para melhorar o retorno.`;
}

function updateDados(){
  if(!currentLot) return;
  const lot=currentLot, zc=ZONE_CFG[lot.zone]||ZONE_CFG.ZEU;
  const dz=document.getElementById('dz-badge');
  dz.style.borderLeftColor=zc.color;
  document.getElementById('dz-name').textContent=lot.zone+' — '+zc.label;
  document.getElementById('dz-desc').textContent=selFids.size>1?`Análise combinada de ${selFids.size} lotes. Zona primária: ${zc.label}`:zc.desc;
  // Development score: area 200-5000m² is ideal for residential tower
  const areaScore = lot.area>=200&&lot.area<=5000 ? '✅ Ideal' : lot.area<200 ? '⚠️ Muito pequeno' : '⚠️ Verificar remembramento';
  document.getElementById('data-rows').innerHTML=`
    <div class="data-row"><span class="dr-lbl">Área ${selFids.size>1?'total':'do terreno'}</span><span class="dr-val">${fmtNum(lot.area)} m²</span></div>
    <div class="data-row"><span class="dr-lbl">Aptidão do tamanho</span><span class="dr-val">${areaScore}</span></div>
    <div class="data-row"><span class="dr-lbl">Uso atual</span><span class="dr-val">${lot.tipo}</span></div>
    <div class="data-row"><span class="dr-lbl">Coef. aproveitamento básico</span><span class="dr-val">1,00</span></div>
    <div class="data-row"><span class="dr-lbl">Coef. aproveitamento ${selFids.size>1?'médio':'máximo'}</span><span class="dr-val">${lot.ca.toFixed(2).replace('.',',')}</span></div>
    <div class="data-row"><span class="dr-lbl">Gabarito de altura</span><span class="dr-val">${lot.gab}</span></div>
    <div class="data-row"><span class="dr-lbl">Recuo frontal mínimo</span><span class="dr-val">${lot.rec.f} m</span></div>
    <div class="data-row"><span class="dr-lbl">Recuo lateral mínimo</span><span class="dr-val">${lot.rec.l} m</span></div>
    <div class="data-row"><span class="dr-lbl">Área construída máxima</span><span class="dr-val">${fmtNum(lot.area*lot.ca)} m²</span></div>
    <div class="data-row"><span class="dr-lbl">Lotes selecionados</span><span class="dr-val">${selFids.size}</span></div>
  `;
}

/* ══════════════════════════════════════════════
   HINT
══════════════════════════════════════════════ */
function setHint(msg, spin=false){
  const el=document.getElementById('hint');
  if(!msg||selFids.size){el.classList.add('hide');return;}
  el.classList.remove('hide');
  el.innerHTML=spin?`<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> ${msg}`:msg;
}

/* ══════════════════════════════════════════════
   VIEW CONTROLS
══════════════════════════════════════════════ */
function setView(threeD){
  is3d=threeD;
  ['c2d','mc2d'].forEach(id=>document.getElementById(id)?.classList.toggle('on',!threeD));
  ['c3d','mc3d'].forEach(id=>document.getElementById(id)?.classList.toggle('on',threeD));
  map.easeTo(threeD?{pitch:60,bearing:-18,duration:800}:{pitch:0,bearing:0,duration:800});
}

/* ══════════════════════════════════════════════
   TABS
══════════════════════════════════════════════ */
function switchTab(btn){
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  ['analise','financeiro','dados'].forEach(t=>document.getElementById('tab-'+t).style.display='none');
  document.getElementById('tab-'+btn.dataset.tab).style.display='block';
  if(selFids.size){
    if(btn.dataset.tab==='analise') updateAnalise();
    if(btn.dataset.tab==='financeiro') updateFinanceiro();
    if(btn.dataset.tab==='dados') updateDados();
  }
}

/* ══════════════════════════════════════════════
   SEARCH
══════════════════════════════════════════════ */
let sTimer;
const sInp=document.getElementById('srchInp');
const sDd=document.getElementById('srchDd');
sInp.addEventListener('input',()=>{
  clearTimeout(sTimer);
  const q=sInp.value.trim();
  if(q.length<3){sDd.classList.remove('open');return;}
  sTimer=setTimeout(()=>doSearch(q),400);
});
sInp.addEventListener('blur',()=>setTimeout(()=>sDd.classList.remove('open'),200));
sInp.addEventListener('focus',()=>{if(sDd.children.length)sDd.classList.add('open');});
async function doSearch(q){
  try{
    const r=await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&countrycodes=br&limit=5`);
    const d=await r.json();
    if(!d.length){sDd.classList.remove('open');return;}
    sDd.innerHTML=d.map(x=>`<div class="hd-srch-item" onclick="flyTo(${x.lon},${x.lat},'${x.display_name.replace(/'/g,"\\'").substring(0,80)}')">${x.display_name.substring(0,80)}</div>`).join('');
    sDd.classList.add('open');
  }catch(e){}
}
function flyTo(lng,lat,label){
  map.flyTo({center:[+lng,+lat],zoom:17,pitch:60,bearing:-18,duration:1400});
  sDd.classList.remove('open');
  sInp.value=label;
  lastBbox='';
  setTimeout(loadBuildings,1600);
}

