<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>UrbanAI — Análise de Viabilidade Imobiliária</title>
<link href="https://unpkg.com/maplibre-gl@4.5.2/dist/maplibre-gl.css" rel="stylesheet">
<script src="https://unpkg.com/maplibre-gl@4.5.2/dist/maplibre-gl.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
/* ── RESET & BASE ──────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg-deep:   #0B1120;
  --bg-card:   #111827;
  --bg-panel:  #1A2233;
  --bg-header: #141E30;
  --border:    #1E3050;
  --txt:       #E8EDF5;
  --txt2:      #6B7FA3;
  --txt3:      #3D5070;
  --accent:    #3B82F6;
  --green:     #22C55E;
  --amber:     #F59E0B;
  --orange:    #F97316;
  --red:       #EF4444;
  --purple:    #A855F7;
  --r:         8px;
  --panel-w:   430px;
  --header-h:  52px;
}
html,body { height:100%; font-family:'Inter',system-ui,-apple-system,sans-serif; background:var(--bg-deep); color:var(--txt); overflow:hidden; }
#app { display:flex; flex-direction:column; height:100vh; }

/* ── HEADER ──────────────────────────────────────── */
header {
  display:flex; align-items:center; gap:12px;
  padding:9px 16px; flex-shrink:0; height:var(--header-h);
  background:var(--bg-header); border-bottom:1px solid var(--border);
  z-index:1000; position:relative;
}
.logo { width:34px;height:34px;border-radius:10px;flex-shrink:0;background:linear-gradient(135deg,#3B82F6,#8B5CF6);display:flex;align-items:center;justify-content:center;font-size:18px; }
.logo-text h1 { font-size:16px;font-weight:800;color:#F1F5F9;letter-spacing:-.3px; }
.logo-text p  { font-size:10px;color:var(--txt2);margin-top:1px; }
.hd-sep { flex:1; }

/* Search */
.hd-search { position:relative;width:260px; }
.hd-search input { width:100%;background:#1a2640;border:1px solid var(--border);border-radius:6px;padding:6px 10px 6px 28px;color:var(--txt);font-size:12px;outline:none;transition:border-color .15s; }
.hd-search input:focus { border-color:var(--accent); }
.hd-search input::placeholder { color:var(--txt2); }
.hd-search .si { position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--txt2);pointer-events:none; }
.hd-srch-dd { position:absolute;top:calc(100%+2px);left:0;right:0;background:#1a2640;border:1px solid var(--border);border-radius:6px;z-index:300;display:none;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.5); }
.hd-srch-dd.open { display:block; }
.hd-srch-item { padding:8px 12px;cursor:pointer;font-size:11px;color:var(--txt2);border-bottom:1px solid var(--border);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.hd-srch-item:last-child { border-bottom:none; }
.hd-srch-item:hover { background:#243558;color:var(--txt); }

/* Chips */
.chip-group { display:flex;align-items:center;gap:4px; }
.chip-lbl { font-size:10px;color:var(--txt2);margin-right:2px; }
.chip { padding:4px 10px;border-radius:5px;border:1px solid var(--border);cursor:pointer;font-size:11px;font-weight:600;background:transparent;color:var(--txt2);transition:all .15s;white-space:nowrap; }
.chip:hover { background:#1a2640;color:var(--txt); }
.chip.on { background:var(--accent);color:white;border-color:var(--accent); }

/* ── BODY ──────────────────────────────────────────── */
#body { display:flex;flex:1;overflow:hidden; }

/* ── MAP ──────────────────────────────────────────── */
#map-wrap { position:relative;flex:1;overflow:hidden; }
#map { position:absolute;inset:0;width:100%;height:100%; }

/* MapLibre overrides */
.maplibregl-ctrl-group { background:rgba(11,17,32,.9)!important;border:1px solid var(--border)!important;border-radius:8px!important;overflow:hidden; }
.maplibregl-ctrl-group button { background:transparent!important;border:none!important; }
.maplibregl-ctrl-group button:hover { background:#1A2233!important; }

/* Map badges */
.map-badge { position:absolute;z-index:10;background:rgba(11,17,32,.93);border:1px solid var(--border);border-radius:var(--r);padding:10px 14px;backdrop-filter:blur(4px); }
.map-badge.tl { top:14px;left:14px; }
.map-badge.tr { top:14px;right:14px; }

#legend .leg-title { font-size:10px;font-weight:700;color:var(--txt3);margin-bottom:8px;letter-spacing:.06em; }
#legend .leg-item  { display:flex;align-items:center;gap:7px;margin-bottom:6px; }
#legend .leg-dot   { width:10px;height:10px;border-radius:3px;flex-shrink:0; }
#legend .leg-lbl   { font-size:11px;color:#CBD5E1; }
#legend .leg-lbl b { color:white; }

#count-badge .cb-t   { font-size:10px;font-weight:700;color:var(--txt3);margin-bottom:2px; }
#count-badge .cb-n   { font-size:26px;font-weight:800;color:var(--txt);line-height:1; }
#count-badge .cb-sub { font-size:10px;color:var(--txt3);margin-top:2px; }

#hint { position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:10;background:rgba(11,17,32,.92);border:1px solid var(--border);border-radius:8px;padding:8px 18px;font-size:12px;color:var(--txt2);white-space:nowrap;pointer-events:none;transition:opacity .3s; }
#hint.hide { opacity:0; }

#mc { position:absolute;bottom:20px;right:16px;display:flex;gap:6px;z-index:10; }
.mc-grp { display:flex;background:rgba(11,17,32,.92);border:1px solid var(--border);border-radius:8px;overflow:hidden;backdrop-filter:blur(8px); }
.mc-btn { padding:5px 10px;font-size:11px;color:var(--txt2);background:transparent;border:none;cursor:pointer;border-right:1px solid var(--border);display:flex;align-items:center;gap:4px;transition:background .12s,color .12s;white-space:nowrap; }
.mc-btn:last-child { border-right:none; }
.mc-btn:hover,.mc-btn.on { background:#1A2233;color:#93C5FD; }

/* ── RIGHT PANEL ──────────────────────────────────── */
#panel {
  width:var(--panel-w);flex-shrink:0;
  background:var(--bg-panel);border-left:1px solid var(--border);
  display:flex;flex-direction:column;overflow:hidden;
}

/* Panel handle (mobile only — hidden on desktop) */
.panel-handle { display:none; }

/* Empty state */
#empty-state { flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;text-align:center; }
#empty-state .es-icon { font-size:50px;margin-bottom:14px; }
#empty-state h2 { font-size:17px;font-weight:700;color:#F1F5F9;margin-bottom:8px; }
#empty-state p  { font-size:13px;color:var(--txt2);line-height:1.7;max-width:260px; }
.feat-grid { display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:22px;width:100%; }
.feat-card { background:var(--bg-card);border-radius:var(--r);padding:12px 14px;border:1px solid var(--border);text-align:left; }
.feat-card .fc-icon  { font-size:19px;margin-bottom:6px; }
.feat-card .fc-title { font-size:12px;font-weight:600;color:#CBD5E1;margin-bottom:2px; }
.feat-card .fc-desc  { font-size:11px;color:#475569; }

/* Lot detail */
#lot-detail { display:none;flex-direction:column;flex:1;overflow:hidden; }

#lot-header { padding:14px 18px;background:var(--bg-card);border-bottom:1px solid var(--border);flex-shrink:0; }
.lh-top { display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px; }
.lh-title { font-size:16px;font-weight:800;color:#F1F5F9;word-break:break-word; }
.lh-addr  { font-size:11px;color:var(--txt2);margin-top:2px; }
.lh-tipo  { font-size:10px;color:#94A3B8;margin-top:2px; }
.lh-right { display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0;margin-left:8px; }
.zone-badge { font-size:11px;font-weight:800;padding:3px 9px;border-radius:5px;color:white;white-space:nowrap; }
.close-btn { background:#1E2E4A;color:var(--txt2);border:none;border-radius:5px;font-size:11px;padding:3px 9px;cursor:pointer;transition:background .15s;white-space:nowrap; }
.close-btn:hover { background:#2a3f5f;color:var(--txt); }
.lot-kpis { display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px; }
.lkpi { background:var(--bg-panel);border-radius:6px;padding:8px 10px; }
.lkpi-lbl { font-size:9px;color:var(--txt2);margin-bottom:3px; }
.lkpi-val { font-size:15px;font-weight:800; }

#tabs { display:flex;border-bottom:1px solid var(--border);flex-shrink:0;background:var(--bg-card); }
.tab-btn { flex:1;padding:10px 4px;border:none;cursor:pointer;font-size:11px;font-weight:700;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;transition:all .15s; }
.tab-btn:hover { color:#94A3B8; }
.tab-btn.on { color:var(--accent);border-bottom-color:var(--accent); }

#tab-content { flex:1;overflow-y:auto;padding:16px 18px; }
#tab-content::-webkit-scrollbar { width:4px; }
#tab-content::-webkit-scrollbar-thumb { background:var(--border);border-radius:2px; }

.sec-title { font-size:10px;font-weight:700;letter-spacing:.06em;color:var(--txt3);margin-bottom:11px;text-transform:uppercase; }

.dz-badge { background:var(--bg-card);border-radius:7px;padding:10px 13px;margin-bottom:11px;border-left:4px solid var(--accent); }
.dz-name  { font-size:12px;font-weight:700; }
.dz-desc  { font-size:11px;color:var(--txt2);margin-top:3px; }
.data-row { display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #111827; }
.dr-lbl   { font-size:12px;color:var(--txt2); }
.dr-val   { font-size:12px;font-weight:700; }

.kpi-grid { display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px; }
.kpi-card { background:var(--bg-card);border-radius:var(--r);padding:10px 12px; }
.kc-lbl   { font-size:10px;color:var(--txt2);margin-bottom:4px; }
.kc-val   { font-size:15px;font-weight:700;line-height:1; }
.kc-sub   { font-size:10px;color:#475569;margin-top:3px; }

.sl-block  { margin-bottom:14px; }
.sl-row    { display:flex;justify-content:space-between;margin-bottom:5px; }
.sl-lbl    { font-size:11px;color:var(--txt2); }
.sl-val    { font-size:12px;font-weight:700; }
.sl-range  { display:flex;justify-content:space-between;margin-top:3px; }
.sl-range span { font-size:9px;color:var(--txt3); }
input[type=range] { width:100%;height:4px;border-radius:2px;cursor:pointer;-webkit-appearance:none;appearance:none;background:#1E3050;outline:none; }
input[type=range]::-webkit-slider-thumb { -webkit-appearance:none;width:14px;height:14px;border-radius:50%;border:2px solid var(--bg-card);cursor:pointer; }
.params-wrap { background:var(--bg-card);border-radius:7px;padding:14px;margin-bottom:12px; }

.formula-box { background:var(--bg-card);border-radius:7px;padding:12px 13px;border:1px solid rgba(34,197,94,.2);margin-top:12px; }
.fb-title { font-size:10px;font-weight:700;color:var(--txt3);margin-bottom:7px; }
.fb-line  { font-size:11px;color:#94A3B8;margin-bottom:5px;line-height:1.5; }
.fb-line .dim { color:var(--txt2); }

.chart-wrap { background:var(--bg-card);border-radius:7px;padding:12px;margin-bottom:11px; }
.cw-title   { font-size:10px;font-weight:700;color:var(--txt3);margin-bottom:8px; }

.verdict { border-radius:7px;padding:12px 14px;margin-top:4px; }
.vd-title { font-size:13px;font-weight:700;margin-bottom:5px; }
.vd-desc  { font-size:11px;color:#94A3B8;line-height:1.6; }

.sources-box { margin-top:14px;background:var(--bg-card);border-radius:7px;padding:12px 13px;border:1px solid var(--border); }
.sb-ttl  { font-size:10px;font-weight:700;color:var(--txt3);margin-bottom:7px; }
.sb-item { font-size:11px;color:var(--txt2);margin-bottom:5px;display:flex;gap:7px; }
.sb-item .arr { color:var(--accent); }

@keyframes spin { to { transform:rotate(360deg); } }

/* ═══════════════════════════════════════════════
   RESPONSIVE — LARGE TABLET / SMALL LAPTOP (≤1100px)
═══════════════════════════════════════════════ */
@media (max-width:1100px){
  :root{ --panel-w:340px; }
  .hd-search { width:190px; }
  .logo-text p { display:none; }
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — TABLET PORTRAIT (641–900px)
   Right-panel stays but becomes narrower
═══════════════════════════════════════════════ */
@media (max-width:900px) and (min-width:641px){
  :root{ --panel-w:280px; }
  .hd-search { width:160px; }
  .logo-text h1 { font-size:14px; }
  #tab-content { padding:12px 13px; }
  .kpi-grid { grid-template-columns:1fr 1fr; gap:6px; }
  .kc-val { font-size:13px; }
  .params-wrap { padding:10px 11px; }
  .chart-wrap canvas { max-height:90px; }
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — MOBILE (≤640px)
   Panel becomes a bottom-sheet drawer
═══════════════════════════════════════════════ */
@media (max-width:640px){
  :root{ --panel-w:100%; --header-h:auto; }

  /* Compact header — 2 rows */
  header {
    flex-wrap:wrap;
    padding:8px 12px;
    gap:6px;
    height:auto;
  }
  .hd-sep { display:none; }
  .hd-search { order:10; width:100%; margin-top:2px; }
  .chip-lbl { display:none; }
  .chip { padding:3px 8px; font-size:10px; }
  .logo-text p { display:none; }

  /* Map fills all remaining height */
  #body { position:relative; flex:1; }
  #map-wrap { height:100%; }

  /* Panel: fixed bottom-sheet */
  #panel {
    position:fixed;
    bottom:0; left:0; right:0;
    width:100%;
    max-height:82vh;
    border-left:none;
    border-top:1px solid var(--border);
    border-radius:16px 16px 0 0;
    z-index:200;
    transform:translateY(calc(100% - 56px));
    transition:transform .35s cubic-bezier(.4,0,.2,1);
    box-shadow:0 -6px 30px rgba(0,0,0,.6);
  }
  #panel.sheet-open  { transform:translateY(0); }
  #panel.sheet-peek  { transform:translateY(calc(100% - 56px)); }

  /* Drag handle — visible on mobile */
  .panel-handle {
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:5px;
    padding:10px 16px 8px;
    cursor:pointer;
    flex-shrink:0;
    background:var(--bg-card);
    border-radius:16px 16px 0 0;
    -webkit-tap-highlight-color:transparent;
  }
  .panel-handle-bar {
    width:40px; height:4px;
    background:var(--border);
    border-radius:2px;
  }
  .panel-handle-label {
    font-size:11px; color:var(--txt2);
    font-weight:600; letter-spacing:.02em;
  }

  /* Empty state smaller */
  #empty-state { padding:16px 14px; }
  #empty-state .es-icon { font-size:36px; margin-bottom:10px; }
  #empty-state h2 { font-size:15px; }
  .feat-grid { grid-template-columns:1fr 1fr; gap:6px; margin-top:12px; }
  .feat-card { padding:9px 10px; }
  .feat-card .fc-icon { font-size:16px; margin-bottom:4px; }

  /* Repositioned map overlays */
  .map-badge.tl { top:10px; left:10px; padding:8px 10px; }
  #legend .leg-title { font-size:9px; }
  #legend .leg-lbl { font-size:10px; }

  /* Count badge → top-right, compact */
  .map-badge.tr {
    top:10px; bottom:auto; right:10px; left:auto;
    padding:6px 10px;
  }
  #cb-num { font-size:18px; }
  #count-badge .cb-t { font-size:9px; }
  #count-badge .cb-sub { font-size:9px; }

  /* Hint & controls — above peeking panel */
  #hint { font-size:11px; padding:6px 14px; bottom:72px; }
  #mc   { bottom:72px; right:10px; }

  /* Compact lot header */
  #lot-header { padding:10px 14px; }
  .lh-title { font-size:14px; }
  .lkpi-val { font-size:13px; }
  .lot-kpis { gap:5px; }
  .lkpi { padding:7px 8px; }

  #tab-content { padding:12px 14px; }
}

/* ═══════════════════════════════════════════════
   VERY SMALL PHONES (≤380px)
═══════════════════════════════════════════════ */
@media (max-width:380px){
  #legend { display:none; }
  .kpi-grid { grid-template-columns:1fr 1fr; }
  .hd-search input { font-size:11px; }
  .lot-kpis { grid-template-columns:1fr 1fr; }
}
</style>
</head>
<body>
<div id="app">

<!-- ── HEADER ─────────────────────────────────────── -->
<header>
  <div class="logo">🏙</div>
  <div class="logo-text">
    <h1>UrbanAI</h1>
    <p>Plataforma de Viabilidade Imobiliária — São Paulo</p>
  </div>
  <div class="hd-sep"></div>
  <div class="hd-search">
    <span class="si"><svg width="12" height="12" viewBox="0 0 24 24" fill="#6B7FA3"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></span>
    <input type="text" id="srchInp" placeholder="Buscar endereço em SP...">
    <div class="hd-srch-dd" id="srchDd"></div>
  </div>
  <div class="chip-group">
    <span class="chip-lbl">Vista:</span>
    <button class="chip" id="c2d" onclick="setView(false)">2D</button>
    <button class="chip on" id="c3d" onclick="setView(true)">3D</button>
  </div>
</header>

<!-- ── BODY ───────────────────────────────────────── -->
<div id="body">

  <!-- MAP -->
  <div id="map-wrap">
    <div id="map"></div>

    <div class="map-badge tl" id="legend">
      <div class="leg-title">ZONEAMENTO (estimado)</div>
      <div class="leg-item"><div class="leg-dot" style="background:#3B82F6"></div><span class="leg-lbl"><b>ZEU</b> — Eixo Urbano</span></div>
      <div class="leg-item"><div class="leg-dot" style="background:#22C55E"></div><span class="leg-lbl"><b>ZM</b> — Zona Mista</span></div>
      <div class="leg-item"><div class="leg-dot" style="background:#A855F7"></div><span class="leg-lbl"><b>ZEIS</b> — Int. Social</span></div>
      <div class="leg-item"><div class="leg-dot" style="background:#F59E0B"></div><span class="leg-lbl"><b>ZC</b> — Zona Central</span></div>
    </div>

    <div class="map-badge tr" id="count-badge">
      <div class="cb-t">TERRENOS CARREGADOS</div>
      <div class="cb-n" id="cb-num">–</div>
      <div class="cb-sub" id="cb-sub">toque para analisar</div>
    </div>

    <div id="hint">Aproxime o mapa para carregar terrenos disponíveis</div>

    <div id="mc">
      <div class="mc-grp">
        <button class="mc-btn" id="mc2d" onclick="setView(false)">2D</button>
        <button class="mc-btn on" id="mc3d" onclick="setView(true)">3D</button>
      </div>
    </div>
  </div>

  <!-- ── RIGHT PANEL ─────────────────────────────── -->
  <div id="panel">

    <!-- Mobile drag handle (hidden on desktop via CSS) -->
    <div class="panel-handle" id="panel-handle" onclick="toggleSheet()">
      <div class="panel-handle-bar"></div>
      <div class="panel-handle-label" id="handle-label">🗺️ Toque para explorar</div>
    </div>

    <!-- Empty state -->
    <div id="empty-state">
      <div class="es-icon">🗺️</div>
      <h2>Selecione um Terreno</h2>
      <p>Toque em qualquer terreno, estacionamento ou imóvel de baixo gabarito no mapa para ver a análise completa.</p>
      <div class="feat-grid">
        <div class="feat-card"><div class="fc-icon">🏗</div><div class="fc-title">Potencial Construtivo</div><div class="fc-desc">CA e área edificável</div></div>
        <div class="feat-card"><div class="fc-icon">💰</div><div class="fc-title">Viabilidade Financeira</div><div class="fc-desc">ROI e lucro estimado</div></div>
        <div class="feat-card"><div class="fc-icon">📋</div><div class="fc-title">Dados Urbanísticos</div><div class="fc-desc">Zoneamento e recuos</div></div>
        <div class="feat-card"><div class="fc-icon">📊</div><div class="fc-title">Simulação Dinâmica</div><div class="fc-desc">Ajuste os parâmetros</div></div>
      </div>
    </div>

    <!-- Lot detail -->
    <div id="lot-detail">
      <div id="lot-header">
        <div class="lh-top">
          <div style="flex:1;min-width:0;">
            <div class="lh-title" id="lh-title">—</div>
            <div class="lh-addr"  id="lh-addr">—</div>
            <div class="lh-tipo"  id="lh-tipo">—</div>
          </div>
          <div class="lh-right">
            <span class="zone-badge" id="lh-zone">ZEU</span>
            <button class="close-btn" id="close-btn" onclick="deselectAll()">✕ fechar</button>
          </div>
        </div>
