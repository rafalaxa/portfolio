  };
}

// ═══════════════════════════════════════════════════════════
// PIECE CALCULATION
// ═══════════════════════════════════════════════════════════
function calcPieces(cfg){
  const {type,W,H,D,nCols,columns:cols=[],shelfD,
         thick:t,backType,latType,frontType,baseType,
         cubaPos,cubaW,cubaD}=cfg;
  const pieces=[]; let ci=0;
  function add(name,w,h,qty){
    if(w<=0||h<=0||qty<=0)return;
    pieces.push({name,w:Math.round(w),h:Math.round(h),qty,color:COLORS[ci%COLORS.length]});
    ci++;
  }
  const latN=latType==='ripado'?'Lateral Ripado':'Lateral';
  const bakN=backType==='ripado'?'Fundo Ripado':'Fundo';

  // PAINEL RIPADO — caso especial, sem colunas
  if(type==='painel_ripado'){
    const ripaW=80, gapW=15;
    const nRipas=Math.max(1,Math.floor(W/(ripaW+gapW)));
    add('Ripa',ripaW,H,nRipas);
    add('Régua Fixação',W,40,2);
    add('Régua Lateral',H-80,40,2);
    return pieces;
  }

  const isCounter = type==='balcao'||type==='gabinete_banheiro';
  const kick = isCounter ? Math.min(150,H*0.1) : 0;
  const bodyH = H-kick;
  const iW=Math.max(1,W-2*t), iH=Math.max(1,bodyH-2*t), iD=Math.max(1,D-t);
  const effShelfD = shelfD>0 ? Math.min(shelfD,iD) : iD;

  add(latN, D, bodyH, 2);
  add('Tampo', iW, D, 1);
  add('Base', iW, D, 1);
  if(backType!=='none') add(bakN, W, bodyH, 1);
  if(frontType==='mdf') add('Frente Painel', W, iH, 1);
  else if(frontType==='ripado') add('Frente Painel Ripado', W, iH, 1);
  if(isCounter) add('Rodapé', iW, kick, 1);

  const nDiv=Math.max(0,nCols-1);
  if(nDiv>0) add('Divisória', iH, iD, nDiv);

  const colW = nCols>0 ? (iW-nDiv*t)/nCols : iW;
  const gap=t;

  cols.forEach(col=>{
    const items=sortBlocksMaleiroFirst((col.blocks||[]).map(b=>{
      let hMM = b.kind==='gaveteiro'?(b.unitH||300):b.kind==='cabideiro'?(b.unitH||1100):(b.unitH||350);
      hMM=Math.min(hMM, iH*0.92);
      // Maleiro fica sempre no topo absoluto da coluna, nunca é editável
      return {b, h:hMM, vertPos: b.kind==='maleiro' ? 'cima' : (b.vertPos||'baixo')};
    }));
    const {placements,freeStart,freeEnd}=layoutColumn(items, iH, gap);

    placements.forEach(p=>{
      const b=p.b, blockH=p.y1-p.y0;
      if(b.kind==='gaveteiro'){
        const {qty=1,sentido='horizontal',doorType:dt='mdf',depth:dep=0}=b;
        if(qty<=0)return;
        const perH=blockH/Math.max(1,qty);
        const oneW = sentido==='vertical'&&qty>1? colW/qty : colW;
        const effD = dep>0?Math.min(dep,iD):iD-10;
        const nm={mdf:'Frente Gaveta',frente:'Frente Gaveta',ripado:'Frente Gaveta Ripado'}[dt]||'Frente Gaveta';
        add(nm, oneW-2, perH, qty);
        add('Lateral Gaveta', effD, perH-t, 2*qty);
        add('Fundo Gaveta', oneW-2*t, effD, qty);
        add('Traseira Gaveta', oneW-2*t, perH-t, qty);
        if(sentido==='vertical'&&qty>1) add('Divisória Gavetas', blockH-2*t, effD, qty-1);
      } else if(b.kind==='cabideiro'){
        const {nRods=1}=b;
        add('Prateleira Cabides', colW, effShelfD, 1);
        if(nRods>1) add('Divisória Cabideiro', blockH, iD-10, nRods-1);
      } else if(b.kind==='sapateira'){
        const vaos=Math.max(1,b.vaos||1);
        if(vaos>1) add('Prateleira Sapateira', colW, effShelfD, vaos-1);
      } else if(b.kind==='maleiro'){
        const {doorType:dt='none'}=b;
        add('Prateleira Maleiro', colW, t, 1);
        if(dt!=='none'){
          const nm={mdf:'Porta Maleiro',frente:'Porta Maleiro',ripado:'Porta Maleiro Ripado'}[dt]||'Porta Maleiro';
          add(nm, colW-2, blockH-2, 1);
        }
      }
    });

    // Porta da coluna: SEMPRE cobre a coluna inteira (piso ao teto), na frente de tudo —
    // gaveteiro/cabideiro/maleiro ficam escondidos atrás, como um armário de porta batente.
    if(col.doorType && col.doorType!=='none'){
      const dt=col.doorType;
      const nm={mdf:'Porta',frente:'Frente',glass:'Porta Vidro*',espelho:'Porta Espelho*',ripado:'Porta Ripado'}[dt]||'Porta';
      add(nm, colW-2, iH, 1);
    }
    // Prateleiras continuam só no vão livre (onde não há gaveteiro/cabideiro/maleiro)
    const freeH=Math.max(0,freeEnd-freeStart);
    if(col.shelves>0 && freeH>10){
      add('Prateleira', colW, effShelfD, col.shelves);
    }
  });

  // Base (plinto) estrutural
  if(baseType==='com'){
    const baseHt=100;
    add('Base Lateral', D, baseHt, 2);
    add('Base Frente', W-2*t, baseHt, 1);
    add('Base Fundo', W-2*t, baseHt, 1);
  }

  return pieces;
}

// ═══════════════════════════════════════════════════════════
// BIN PACKING — Guillotine BSSF
// ═══════════════════════════════════════════════════════════
class Sheet{
  constructor(sw,sh){this.sw=sw;this.sh=sh;this.free=[{x:0,y:0,w:sw,h:sh}];this.placed=[];}
  tryPlace(p,kerf){
    const pw=p.w+kerf,ph=p.h+kerf;
    let bi=-1,bs=Infinity,bRot=false;
    for(let i=0;i<this.free.length;i++){
      const r=this.free[i];
      if(pw<=r.w&&ph<=r.h){const sc=r.w*r.h;if(sc<bs){bs=sc;bi=i;bRot=false;}}
      if(ph<=r.w&&pw<=r.h){const sc=r.w*r.h;if(sc<bs){bs=sc;bi=i;bRot=true;}}
    }
    if(bi===-1)return false;
    const r=this.free[bi];
    const uw=bRot?ph:pw,uh=bRot?pw:ph;
    this.placed.push({name:p.name,color:p.color,x:r.x,y:r.y,w:bRot?p.h:p.w,h:bRot?p.w:p.h,rotated:bRot});
    const nr=[];
    if(r.h-uh>kerf)nr.push({x:r.x,y:r.y+uh,w:r.w,h:r.h-uh});
    if(r.w-uw>kerf)nr.push({x:r.x+uw,y:r.y,w:r.w-uw,h:uh});
    this.free.splice(bi,1,...nr);
    return true;
  }
  usedArea(){return this.placed.reduce((s,p)=>s+p.w*p.h,0);}
  efficiency(){return(this.usedArea()/(this.sw*this.sh)*100).toFixed(1);}
}

function packAll(pieces,sw,sh,kerf){
  const flat=[];
  pieces.forEach(p=>{for(let i=0;i<p.qty;i++)flat.push({name:p.name,w:p.w,h:p.h,color:p.color});});
  flat.sort((a,b)=>b.w*b.h-a.w*a.h);
  const sheets=[],unplaced=[];
  for(const p of flat){
    if(p.name.endsWith('*')){continue;} // peças sob encomenda (vidro/espelho) — não cortadas do MDF
    const fN=(p.w+kerf)<=sw&&(p.h+kerf)<=sh;
    const fR=(p.h+kerf)<=sw&&(p.w+kerf)<=sh;
    if(!fN&&!fR){unplaced.push(p);continue;}
    let ok=false;
    for(const s of sheets){if(s.tryPlace(p,kerf)){ok=true;break;}}
    if(!ok){const ns=new Sheet(sw,sh);ns.tryPlace(p,kerf);sheets.push(ns);}
  }
  return{sheets,unplaced};
}

// ═══════════════════════════════════════════════════════════
// CALCULATE
// ═══════════════════════════════════════════════════════════
function calculate(){
  const cfg=getConfig();
  if(cfg.W<=0||cfg.H<=0||cfg.D<=0){alert('Insira dimensões válidas!');return;}
  const pieces=calcPieces(cfg);
  if(!pieces.length){alert('Nenhuma peça gerada.');return;}
  const {sheets,unplaced}=packAll(pieces,cfg.sw,cfg.sh,cfg.kerf);
  const totalPieces=pieces.reduce((s,p)=>s+p.qty,0);
  const totalUsed=sheets.reduce((s,sh)=>s+sh.usedArea(),0);
  const totalAvail=sheets.length*cfg.sw*cfg.sh;
  const eff=totalAvail>0?(totalUsed/totalAvail*100).toFixed(1):'0';
  const cost=sheets.length*cfg.price;
  projectData={cfg,pieces,sheets,unplaced,totalPieces,eff,cost};

  document.getElementById('statsSection').style.display='block';
  document.getElementById('sSheets').textContent=sheets.length;
  document.getElementById('sEff').textContent=eff+'%';
  document.getElementById('sPieces').textContent=totalPieces;
  document.getElementById('sCost').textContent='R$'+cost.toFixed(0);

  const wb=document.getElementById('warnBox');
  if(unplaced.length>0){
    wb.style.display='block';
    wb.innerHTML='⚠️ '+unplaced.length+' peça(s) não encaixam na chapa:<br>'+
      unplaced.map(p=>`• ${p.name} (${p.w}×${p.h}mm)`).join('<br>');
  } else wb.style.display='none';

  update3D(cfg);
  updateMap(sheets,cfg);
  updatePieces(pieces,cfg);
  updatePanelTags(cfg);
}

