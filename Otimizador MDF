  const colsSummary=(cfg.columns||[]).map((c,i)=>`Col.${i+1}:${dMap[c.doorType]||c.doorType}${c.blocks&&c.blocks.length?'('+c.blocks.map(b=>b.kind).join('+')+')':''}`).join(' | ');
  const rows=[
    ['Tipo de Móvel:',    typeNames[cfg.type]||cfg.type],
    ['Dimensões:',        `${cfg.W} × ${cfg.H} × ${cfg.D} mm  (L × A × P)`],
    ['Nº de Colunas:',    String(cfg.nCols)],
    ['Colunas:',          colsSummary||'Nenhuma'],
    ['Fundo / Laterais:', `${bTypeNames[cfg.backType]||cfg.backType} / ${cfg.latType==='ripado'?'Ripado':'MDF Liso'}`],
    ['Frente Painel:',    frTypeNames[cfg.frontType||'none']],
