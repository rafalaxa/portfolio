// ═══════════════════════════════════════════════════════════
// LAYOUT ENGINE — generic vertical stacking inside a column
// (used identically by calcPieces — in mm — and update3D — in scene units)
// ═══════════════════════════════════════════════════════════
function layoutColumn(items, totalH, gap){
  let baixoY=0, cimaY=totalH;
  const placements=[]; const meios=[];
  items.forEach(it=>{
    if(it.vertPos==='cima'){ const y1=cimaY,y0=cimaY-it.h; cimaY=y0-gap; placements.push(Object.assign({},it,{y0,y1})); }
    else if(it.vertPos==='meio'){ meios.push(it); }
    else { const y0=baixoY,y1=baixoY+it.h; baixoY=y1+gap; placements.push(Object.assign({},it,{y0,y1})); }
  });
  meios.forEach(it=>{
    const gapStart=baixoY, gapEnd=cimaY, size=Math.max(0,gapEnd-gapStart);
    const y0=gapStart+size/2-it.h/2, y1=y0+it.h;
    placements.push(Object.assign({},it,{y0,y1}));
  });
  return {placements, freeStart:baixoY, freeEnd:Math.max(baixoY,cimaY)};
}
// Maleiro é sempre o item mais alto da coluna: processado primeiro entre os 'cima',
// garantindo que fica no topo absoluto (acima de cabideiro/outros blocos 'cima').
function sortBlocksMaleiroFirst(items){
  return items.slice().sort((a,b)=>(a.b.kind==='maleiro'?-1:0)-(b.b.kind==='maleiro'?-1:0));
}

