    doc.setFont('helvetica','normal');doc.setFontSize(9);
    doc.text(`${cfg.sw}×${cfg.sh}mm · Aproveitamento: ${sh.efficiency()}%`,200,13);
    const mL=L,mT=24,avW=297-mL*2,avH=210-mT-12;
    const sc=Math.min(avW/cfg.sw,avH/cfg.sh);
    const sW=cfg.sw*sc,sH=cfg.sh*sc;
    doc.setFillColor(200,168,120);doc.rect(mL,mT,sW,sH,'F');
    doc.setDrawColor(136,100,64);doc.setLineWidth(0.4);doc.rect(mL,mT,sW,sH,'S');
    sh.placed.forEach(p=>{
      const rgb=hexRGB(p.color);
      doc.setFillColor(rgb.r,rgb.g,rgb.b);
      doc.setDrawColor(Math.max(0,rgb.r-45),Math.max(0,rgb.g-45),Math.max(0,rgb.b-45));
      doc.setLineWidth(0.25);
      const px=mL+p.x*sc,py=mT+p.y*sc,pw=p.w*sc,ph=p.h*sc;
      doc.rect(px+.4,py+.4,pw-.8,ph-.8,'FD');
      if(pw>7&&ph>5){
        doc.setTextColor(20,10,5);doc.setFont('helvetica','bold');
        const fs=clamp(Math.min(pw,ph)*.28,3.5,7);doc.setFontSize(fs);
        doc.text(p.name.replace('*',''),px+pw/2,py+ph/2-fs*.3,{align:'center'});
        doc.setFont('helvetica','normal');doc.setFontSize(fs*.82);
        doc.text(`${p.w}×${p.h}`,px+pw/2,py+ph/2+fs*.5,{align:'center'});
      }
    });
  });
  doc.save(`mdf-projeto-${Date.now()}.pdf`);
}
function hexRGB(hex){
  const r=/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return r?{r:parseInt(r[1],16),g:parseInt(r[2],16),b:parseInt(r[3],16)}:{r:200,g:120,b:50};
}

// ═══════════════════════════════════════════════════════════
// CSV
// ═══════════════════════════════════════════════════════════
function copyCSV(){
  if(!projectData)return;
  let csv='Peça,Quantidade,Largura (mm),Altura (mm),Área (m²)\n';
  projectData.pieces.forEach(p=>{
    csv+=`${p.name.replace('*','')},${p.qty},${p.w},${p.h},${(p.w*p.h*p.qty/1e6).toFixed(4)}\n`;
  });
  navigator.clipboard.writeText(csv).then(()=>{
    const b=document.querySelector('.btn-csv');
    const o=b.textContent;b.textContent='✅ Copiado!';setTimeout(()=>b.textContent=o,2000);
  });
}

// ═══════════════════════════════════════════════════════════
// UI HELPERS
// ═══════════════════════════════════════════════════════════
function onSheetChange(){
  document.getElementById('customSheet').style.display=
    document.getElementById('sheetPreset').value==='custom'?'block':'none';
}

function onTypeChange(){
  const t=document.getElementById('fType').value;
  const showCuba=['balcao','gabinete_banheiro'].includes(t);
  document.getElementById('cubaSection').style.display=showCuba?'block':'none';
  document.getElementById('columnsSection').style.display=t==='painel_ripado'?'none':'block';
  if(!showCuba){
    document.getElementById('cubaPos').value='none';
    document.getElementById('cubaDims').style.display='none';
  }
  if(t==='painel_ripado'){
    document.getElementById('fH').value=2400;document.getElementById('fD').value=80;
  } else if(t==='nicho'||t==='estante'){
    document.getElementById('nCols').value=1;
    columns=[{doorType:'none',shelves:3,blocks:[]}];
  } else if(t==='balcao'){
    document.getElementById('fH').value=900;document.getElementById('fD').value=600;
    document.getElementById('nCols').value=2;
    columns=[
      {doorType:'mdf',shelves:0,blocks:[{kind:'gaveteiro',vertPos:'baixo',qty:2,unitH:300,sentido:'horizontal',doorType:'mdf',depth:0}]},
      {doorType:'mdf',shelves:0,blocks:[]}
    ];
  } else if(t==='gabinete_banheiro'){
    document.getElementById('fW').value=600;document.getElementById('fH').value=870;document.getElementById('fD').value=470;
    document.getElementById('nCols').value=1;
    columns=[{doorType:'mdf',shelves:0,blocks:[{kind:'gaveteiro',vertPos:'baixo',qty:1,unitH:200,sentido:'horizontal',doorType:'mdf',depth:0}]}];
  } else if(t==='closet'){
    document.getElementById('nCols').value=3;
    columns=[
      {doorType:'mdf',shelves:0,blocks:[{kind:'cabideiro',vertPos:'cima',nRods:1,unitH:1100},{kind:'gaveteiro',vertPos:'baixo',qty:2,unitH:300,sentido:'horizontal',doorType:'mdf',depth:0}]},
      {doorType:'mdf',shelves:3,blocks:[]},
      {doorType:'mdf',shelves:0,blocks:[{kind:'cabideiro',vertPos:'cima',nRods:1,unitH:1100}]}
    ];
  } else {
    document.getElementById('nCols').value=3;
    columns=[
      {doorType:'mdf',shelves:0,blocks:[{kind:'gaveteiro',vertPos:'baixo',qty:2,unitH:300,sentido:'horizontal',doorType:'mdf',depth:0}]},
      {doorType:'mdf',shelves:3,blocks:[]},
      {doorType:'mdf',shelves:3,blocks:[]}
    ];
  }
  renderColumns();
}

function onLegsTypeChange(){
  const v=document.getElementById('legsType').value;
  document.getElementById('legsDims').style.display=v==='com'?'block':'none';
}
function onCubaPosChange(){
  const pos=document.getElementById('cubaPos').value;
  document.getElementById('cubaDims').style.display=pos!=='none'?'block':'none';
}

document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.tagName!=='BUTTON')calculate();});
window.addEventListener('load',()=>{
  onTypeChange();
  setTimeout(init3D,80);
});

// ── Auto-recálculo da barra lateral (depois do 1º cálculo manual) ──
let _autoCalcTimer=null;
function scheduleAutoCalc(){
  if(!projectData)return;
  clearTimeout(_autoCalcTimer);
  _autoCalcTimer=setTimeout(calculate,350);
}
document.querySelector('.sidebar').addEventListener('input',e=>{
  if(e.target.closest('#statsSection'))return;
  scheduleAutoCalc();
});
document.querySelector('.sidebar').addEventListener('change',e=>{
  if(e.target.closest('#statsSection'))return;
  scheduleAutoCalc();
});
</script>
