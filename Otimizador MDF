    ['Estrutura:',        `Base: ${cfg.baseType==='com'?'Com base':'Sem base'} · Pezinhos: ${cfg.legsType==='com'?`Com (${cfg.legsH}×${cfg.legsW}mm)`:'Sem'}`],
    ['Cuba / Pia:',       cubaNames[cfg.cubaPos||'none']+(cfg.cubaPos&&cfg.cubaPos!=='none'?` · ${cfg.cubaW}×${cfg.cubaD||350}mm`:'')],
    ['Espessura MDF:',    cfg.thick+' mm'],
    ['Kerf / Serra:',     cfg.kerf+' mm'],
    ['Chapa:',            `${cfg.sw} × ${cfg.sh} mm`],
  ];
  doc.setFontSize(9);
  rows.forEach(([k,v],i)=>{
    doc.setFont('helvetica','bold');doc.setTextColor(80,60,30);doc.text(k,L,57+i*7);
    doc.setFont('helvetica','normal');doc.setTextColor(30,30,50);
    const vs=doc.splitTextToSize(String(v),130);
    doc.text(vs,L+42,57+i*7);
  });

  const stY=160,cW=41,cG=5;
  [{label:'Chapas',val:String(sheets.length)},{label:'Aproveitamento',val:eff+'%'},
   {label:'Total Peças',val:String(totalPieces)},{label:'Custo',val:'R$ '+cost.toFixed(2)}
  ].forEach((s,i)=>{
