const _groupMeta={
  base:    {icon:'🪵',label:'Estrutura'},
  doors:   {icon:'🚪',label:'Porta'},
  drawers: {icon:'🗄',label:'Gaveta'},
  shelves: {icon:'📦',label:'Prateleira'},
  cuba:    {icon:'🚰',label:'Cuba'},
  maleiro: {icon:'🧳',label:'Maleiro'},
  cabideiro:{icon:'👔',label:'Cabideiro'},
};
function getMeshGroup(mesh){
  for(const [name,arr] of Object.entries(meshGroups)){if(arr.includes(mesh))return name;}
  return 'base';
}
function getGroupLabel(mesh){
  const g=getMeshGroup(mesh);
  const m=_groupMeta[g]||{icon:'🪵',label:'Peça'};
  return m.icon+' '+m.label;
}
function showEdit3D(mesh){
  const g=getMeshGroup(mesh);
  const meta=_groupMeta[g]||{icon:'🪵',label:'Peça'};
  const geo=mesh.geometry.parameters;
  const toMM=v=>Math.round(Math.abs(v)/Math.max(currentS,0.0001));
  const dims=geo?`${toMM(geo.width||0)} × ${toMM(geo.height||0)} × ${toMM(geo.depth||0)} mm`:'';
  document.getElementById('edit3d-title').innerHTML=`${meta.icon} ${meta.label}`;
  document.getElementById('edit3d-dims').textContent=dims||'';
  const actions=document.getElementById('edit3d-actions');
  actions.innerHTML=`<button class="btn-sm" onclick="toggleGroup('${g}','${meta.icon}')" style="font-size:10px;padding:4px 8px">👁 Ocultar/Mostrar</button>`;
  document.getElementById('edit3d-panel').style.display='block';
}
function closeEdit3D(){
  selectedMesh=null;
  if(selectBoxMesh)selectBoxMesh.visible=false;
