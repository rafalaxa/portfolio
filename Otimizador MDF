<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MDF Optimizer Pro — Otimização de Corte para Marcenaria</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0D0D14;--surface:#17172A;--surface2:#1F1F33;--border:#2A2A45;
  --primary:#D4892A;--primary-h:#E8A040;--primary-d:#A8681E;
  --text:#E2E2F0;--muted:#6868A0;
  --ok:#3CB371;--warn:#FFB830;--err:#E05050;
}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden}
header{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.logo{font-size:19px;font-weight:800;background:linear-gradient(135deg,#D4892A,#F5C878);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.logo-sub{font-size:11px;color:var(--muted);margin-top:-2px}
.badge{font-size:10px;background:var(--primary-d);color:#fff;border-radius:20px;padding:2px 10px;font-weight:600}
.main{display:flex;flex:1;overflow:hidden}
.sidebar{width:380px;min-width:320px;background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:11px;flex-shrink:0}
.sec-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:5px}
.sub-sec{font-size:10px;color:var(--primary);margin:3px 0 5px;padding-left:6px;border-left:2px solid var(--primary-d);font-weight:600}
.form-group{margin-bottom:8px}
label{display:block;font-size:12px;color:var(--muted);margin-bottom:3px}
input,select{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:6px 8px;font-size:13px;outline:none;transition:border-color .18s}
input:focus,select:focus{border-color:var(--primary)}
input[type=number]::-webkit-inner-spin-button{opacity:.4}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}
.divider{height:1px;background:var(--border)}
.btn-calc{width:100%;padding:11px;background:linear-gradient(135deg,var(--primary),#E8A040);border:none;border-radius:8px;color:#fff;font-size:14px;font-weight:700;cursor:pointer;transition:opacity .2s,transform .1s}
.btn-calc:hover{opacity:.9}
.btn-calc:active{transform:scale(.99)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stat-card{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:9px;text-align:center}
.stat-val{font-size:19px;font-weight:800;color:var(--primary)}
.stat-lbl{font-size:10px;color:var(--muted);margin-top:1px}
.warn-box{background:#2A1A0A;border:1px solid #A06020;border-radius:6px;padding:8px 10px;font-size:11px;color:#FFB830;line-height:1.4}
.content{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.tabs{display:flex;background:var(--surface);border-bottom:1px solid var(--border);padding:0 18px;flex-shrink:0}
.tab{padding:11px 16px;cursor:pointer;font-size:13px;color:var(--muted);border-bottom:2px solid transparent;transition:color .18s;user-select:none}
.tab:hover{color:var(--text)}
.tab.active{color:var(--primary);border-bottom-color:var(--primary)}
.tab-content{flex:1;overflow:hidden;position:relative}
.tab-panel{display:none;height:100%;flex-direction:column}
.tab-panel.active{display:flex}
#canvas3d{width:100%;height:100%;display:block;cursor:grab}
#canvas3d:active{cursor:grabbing}
.overlay-hint{position:absolute;bottom:14px;left:14px;background:rgba(0,0,0,.55);border-radius:6px;padding:5px 10px;font-size:11px;color:var(--muted);pointer-events:none}
.controls-3d{position:absolute;top:12px;right:12px;display:flex;flex-direction:column;gap:5px}
.btn-sm{background:rgba(23,23,42,.92);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:5px 10px;font-size:11px;cursor:pointer;transition:background .18s;white-space:nowrap}
.btn-sm:hover{background:var(--surface2)}
#empty-3d{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--muted);background:var(--surface)}
.empty-icon{font-size:52px;opacity:.4}
.empty-title{font-size:17px;font-weight:600}
.empty-sub{font-size:12px}
.map-area{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:16px}
.sheet-card{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:12px}
.sheet-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;flex-wrap:wrap;gap:7px}
.sheet-title{font-size:13px;font-weight:700}
.sheet-meta{display:flex;gap:12px;font-size:11px;color:var(--muted)}
.eff-bar{height:4px;background:var(--border);border-radius:2px;margin-bottom:10px;overflow:hidden}
.eff-fill{height:100%;border-radius:2px;transition:width .5s}
canvas.map-canvas{width:100%;height:auto;display:block;border-radius:4px}
.piece-area{flex:1;overflow-y:auto;padding:16px}
table.ptable{width:100%;border-collapse:collapse;font-size:12px}
.ptable th{background:var(--surface2);padding:8px 10px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);border-bottom:1px solid var(--border)}
.ptable td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text)}
.ptable tr:hover td{background:var(--surface2)}
.ptable tfoot td{font-weight:700;color:var(--primary);border-top:2px solid var(--border)}
.dot{width:11px;height:11px;border-radius:3px;display:inline-block;margin-right:5px;vertical-align:middle}
.export-bar{padding:9px 16px;background:var(--surface);border-top:1px solid var(--border);display:flex;gap:8px;align-items:center;flex-shrink:0}
.btn-pdf{padding:7px 15px;background:var(--primary);border:none;border-radius:6px;color:#fff;font-size:12px;font-weight:700;cursor:pointer;transition:opacity .2s}
.btn-pdf:hover{opacity:.85}
.btn-csv{padding:7px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:12px;cursor:pointer;transition:background .18s}
.btn-csv:hover{background:var(--border)}
.export-info{font-size:11px;color:var(--muted);margin-left:auto}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--muted)}
.opt-tag{display:inline-block;font-size:9px;padding:2px 6px;border-radius:4px;margin:2px 2px 2px 0;vertical-align:middle;font-weight:600}
.tag-ripado{background:#2A2010;color:#D4892A;border:1px solid #6A4010}
.tag-glass{background:#102030;color:#80C8F0;border:1px solid #206080}
.tag-none{background:#201020;color:#A06080;border:1px solid #602040}
.tag-cuba{background:#0A2030;color:#60B8E0;border:1px solid #1A5070}
.tag-default{background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
.cuba-box{background:#0F1E28;border:1px solid #1A4860;border-radius:6px;padding:8px 10px;margin-top:3px}
.col-card{background:var(--bg);border:1px solid var(--primary-d);border-radius:8px;padding:9px;margin-bottom:8px}
.col-card-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}
.col-card-label{font-size:12px;font-weight:700;color:var(--primary)}
.col-card-w{font-size:10px;color:var(--muted)}
.block-card{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:7px;margin-bottom:6px}
.block-card-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
.block-card-label{font-size:10px;font-weight:700;color:var(--text)}
.btn-del{background:none;border:none;color:var(--err);cursor:pointer;font-size:16px;line-height:1;padding:0 3px;opacity:.7;transition:opacity .15s}
.btn-del:hover{opacity:1}
.btn-add-unit{padding:6px;background:none;border:1.5px dashed var(--border);border-radius:6px;color:var(--muted);font-size:10px;cursor:pointer;transition:all .18s}
.btn-add-unit:hover{border-color:var(--primary);color:var(--primary)}
.col-add-row{display:flex;gap:4px;margin-top:2px}
.col-add-row .btn-add-unit{flex:1}
</style>
</head>
<body>

<header>
  <div>
    <div class="logo">🪵 MDF Optimizer Pro</div>
    <div class="logo-sub">Otimização inteligente de chapas para marcenaria</div>
  </div>
  <span class="badge">v7.0</span>
</header>

<div class="main">
  <aside class="sidebar">

    <div>
      <div class="sec-title">Tipo de Móvel</div>
      <div class="form-group">
        <select id="fType" onchange="onTypeChange()">
          <option value="armario">🚪 Armário</option>
          <option value="estante">📚 Estante Aberta</option>
          <option value="nicho">⬛ Nicho / Box</option>
          <option value="balcao">🍳 Balcão de Cozinha</option>
          <option value="gabinete_banheiro">🚿 Gabinete de Banheiro</option>
          <option value="closet">👗 Closet / Guarda-Roupa</option>
          <option value="painel_ripado">〰️ Painel Ripado</option>
        </select>
      </div>
    </div>

    <div class="divider"></div>

    <div>
      <div class="sec-title">Dimensões <span style="font-weight:400;font-size:9px">(mm)</span></div>
      <div class="row2">
        <div class="form-group"><label>Largura</label><input type="number" id="fW" value="2200" min="50" max="6000" step="10" onchange="renderColumns()"></div>
        <div class="form-group"><label>Altura</label><input type="number" id="fH" value="2200" min="50" max="3000" step="10"></div>
      </div>
      <div class="form-group"><label>Profundidade</label><input type="number" id="fD" value="500" min="50" max="2000" step="10"></div>
    </div>

    <div class="divider"></div>

    <div id="columnsSection">
      <div class="sec-title">Estrutura de Colunas</div>
      <div class="row2">
        <div class="form-group"><label>Nº de Colunas</label><input type="number" id="nCols" value="3" min="1" max="6" onchange="setNCols()"></div>
        <div class="form-group"><label>Prof. Prateleira (mm)</label><input type="number" id="shelfD" value="0" min="0" step="10" placeholder="Auto"></div>
      </div>
      <div id="columnsContainer"></div>
      <button class="btn-add-unit" style="width:100%" onclick="addColumn()">＋ Adicionar Coluna</button>
    </div>

    <div class="divider"></div>

    <div id="cubaSection" style="display:none">
      <div class="sec-title">Cuba / Pia</div>
      <div class="cuba-box">
        <div class="form-group">
          <label>Posição da Cuba</label>
          <select id="cubaPos" onchange="onCubaPosChange()">
            <option value="none">✖ Sem Cuba</option>
            <option value="center">⬛ Centro</option>
            <option value="left">◀ Esquerda</option>
            <option value="right">▶ Direita</option>
          </select>
        </div>
        <div id="cubaDims" style="display:none">
          <div class="row2">
            <div class="form-group"><label>Largura Cuba (mm)</label><input type="number" id="cubaW" value="400" min="200" max="1200" step="10"></div>
            <div class="form-group"><label>Prof. Cuba (mm)</label><input type="number" id="cubaD" value="350" min="150" max="600" step="10"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div>
      <div class="sec-title">Painéis</div>
      <div class="row3">
        <div class="form-group">
          <label>Fundo</label>
          <select id="backType">
            <option value="mdf">🪵 Liso</option>
            <option value="ripado">〰️ Ripado</option>
            <option value="none">✖ Sem</option>
          </select>
        </div>
        <div class="form-group">
          <label>Laterais</label>
          <select id="latType">
            <option value="mdf">🪵 Liso</option>
            <option value="ripado">〰️ Ripado</option>
          </select>
        </div>
        <div class="form-group">
          <label>Frente</label>
          <select id="frontType">
            <option value="none">✖ Sem</option>
            <option value="mdf">🪵 MDF</option>
            <option value="ripado">〰️ Ripado</option>
          </select>
        </div>
      </div>
      <div id="panelTags" style="margin-top:2px"></div>
    </div>

    <div class="divider"></div>

    <div>
      <div class="sec-title">Estrutura</div>
      <div class="row2">
        <div class="form-group">
          <label>Tipo de Base</label>
          <select id="baseType">
            <option value="none">✖ Sem Base</option>
            <option value="com">✔ Com Base</option>
          </select>
        </div>
        <div class="form-group">
          <label>Pezinhos</label>
          <select id="legsType" onchange="onLegsTypeChange()">
            <option value="none">✖ Sem</option>
            <option value="com">✔ Com Pezinhos</option>
          </select>
        </div>
      </div>
      <div id="legsDims" style="display:none">
        <div class="row2">
          <div class="form-group"><label>Alt. Pezinho (mm)</label><input type="number" id="legsH" value="80" min="20" max="300" step="5"></div>
          <div class="form-group"><label>Larg. Pezinho (mm)</label><input type="number" id="legsW" value="40" min="10" max="100" step="5"></div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div>
      <div class="sec-title">Chapa de MDF</div>
      <div class="form-group">
        <label>Tamanho da Chapa</label>
        <select id="sheetPreset" onchange="onSheetChange()">
          <option value="2750x1850">2750 × 1850 mm (padrão)</option>
          <option value="2200x1850">2200 × 1850 mm</option>
          <option value="1850x1000">1850 × 1000 mm (meia chapa)</option>
          <option value="custom">Personalizado…</option>
        </select>
      </div>
      <div id="customSheet" style="display:none">
        <div class="row2">
          <div class="form-group"><label>Larg. chapa</label><input type="number" id="sheetW" value="2750" min="300"></div>
          <div class="form-group"><label>Alt. chapa</label><input type="number" id="sheetH" value="1850" min="300"></div>
        </div>
      </div>
      <div class="row3">
        <div class="form-group">
          <label>Espessura MDF</label>
          <select id="thick">
            <option value="15">15 mm</option>
            <option value="18" selected>18 mm</option>
            <option value="25">25 mm</option>
          </select>
        </div>
        <div class="form-group">
          <label>Kerf</label>
          <select id="kerf">
            <option value="3" selected>3 mm</option>
            <option value="4">4 mm</option>
            <option value="5">5 mm</option>
          </select>
        </div>
        <div class="form-group">
          <label>R$/chapa</label>
          <input type="number" id="price" value="180" min="0" step="5">
        </div>
      </div>
    </div>

    <button class="btn-calc" onclick="calculate()">⚡ Calcular Otimização</button>

    <div id="statsSection" style="display:none">
      <div class="divider"></div>
      <div class="sec-title">Resumo</div>
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-val" id="sSheets">—</div><div class="stat-lbl">Chapas</div></div>
        <div class="stat-card"><div class="stat-val" id="sEff">—</div><div class="stat-lbl">Aproveitamento</div></div>
        <div class="stat-card"><div class="stat-val" id="sPieces">—</div><div class="stat-lbl">Total Peças</div></div>
        <div class="stat-card"><div class="stat-val" id="sCost">—</div><div class="stat-lbl">Custo Material</div></div>
      </div>
      <div id="warnBox" class="warn-box" style="display:none"></div>
    </div>

  </aside>

  <div class="content">
    <div class="tabs">
      <div class="tab active" onclick="switchTab('3d',this)">📐 Modelo 3D</div>
      <div class="tab" onclick="switchTab('map',this)">✂️ Mapa de Corte</div>
      <div class="tab" onclick="switchTab('pcs',this)">📋 Lista de Peças</div>
    </div>
    <div class="tab-content">

      <div class="tab-panel active" id="tab-3d" style="position:relative">
        <canvas id="canvas3d"></canvas>
        <div class="overlay-hint">🖱 Arrastar = rotacionar · Scroll = zoom</div>
        <div class="controls-3d">
          <button class="btn-sm" onclick="resetCam()">🎯 Reset câmera</button>
          <button class="btn-sm" id="doorToggleBtn"   onclick="toggleGroup('doors','🚪')">🚪 Ocultar portas</button>
          <button class="btn-sm" id="drawerToggleBtn" onclick="toggleGroup('drawers','🗄')">🗄 Ocultar gavetas</button>
          <button class="btn-sm" id="shelfToggleBtn"  onclick="toggleGroup('shelves','📦')">📦 Ocultar prateleiras</button>
          <button class="btn-sm" id="cubaToggleBtn"   onclick="toggleGroup('cuba','🚰')" style="display:none">🚰 Ocultar cuba</button>
        </div>
        <div id="edit3d-panel" style="display:none;position:absolute;bottom:55px;left:14px;background:rgba(15,15,26,.96);border:1px solid var(--border);border-radius:10px;padding:11px 14px;min-width:210px;z-index:20;backdrop-filter:blur(4px)">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:7px">
            <span id="edit3d-title" style="font-size:12px;color:var(--primary);font-weight:700"></span>
            <button onclick="closeEdit3D()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;line-height:1">✕</button>
          </div>
          <div id="edit3d-dims" style="font-size:11px;color:var(--muted);margin-bottom:6px"></div>
          <div id="edit3d-actions" style="display:flex;flex-wrap:wrap;gap:5px"></div>
        </div>
        <div id="hover3d-label" style="display:none;position:absolute;pointer-events:none;background:rgba(0,0,0,.75);border-radius:5px;padding:3px 8px;font-size:10px;color:var(--text);z-index:15;white-space:nowrap"></div>
        <div id="empty-3d">
          <div class="empty-icon">🪵</div>
          <div class="empty-title">Configure o móvel</div>
          <div class="empty-sub">Preencha os campos e clique em Calcular</div>
        </div>
      </div>

      <div class="tab-panel" id="tab-map">
        <div class="map-area" id="mapArea">
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px;color:var(--muted)">
            <div style="font-size:48px;opacity:.4">✂️</div>
            <div style="font-size:17px;font-weight:600">Nenhum projeto calculado</div>
            <div style="font-size:12px">Configure e clique em Calcular</div>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="tab-pcs" style="overflow:hidden">
        <div class="piece-area" id="pieceArea">
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px;color:var(--muted)">
            <div style="font-size:48px;opacity:.4">📋</div>
            <div style="font-size:17px;font-weight:600">Nenhum projeto calculado</div>
            <div style="font-size:12px">Configure e clique em Calcular</div>
          </div>
        </div>
        <div class="export-bar" id="exportBar" style="display:none">
          <button class="btn-pdf" onclick="exportPDF()">📄 Exportar PDF</button>
          <button class="btn-csv" onclick="copyCSV()">📊 Copiar CSV</button>
          <span class="export-info" id="exportInfo"></span>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════
let projectData = null;
let scene, camera, renderer;
let isDrag = false, prevMouse = {x:0,y:0};
let camSph = {theta:0.75, phi:0.48, r:5};
let meshGroups = {base:[], doors:[], drawers:[], shelves:[], cuba:[], maleiro:[], cabideiro:[]};
let groupVisible = {doors:true, drawers:true, shelves:true, cuba:true, maleiro:true, cabideiro:true};
let currentS = 1;
let raycaster3d = null, mouse3d = new (typeof THREE!=='undefined'?THREE.Vector2:Object)();
let hoveredMesh = null, selectedMesh = null;
let hoverBoxMesh = null, selectBoxMesh = null;

// Cada coluna: {doorType:'mdf'|'frente'|'glass'|'ripado'|'none', shelves:N, blocks:[block,...]}
// Cada block: {kind:'gaveteiro'|'cabideiro'|'maleiro', vertPos:'baixo'|'meio'|'cima', ...campos específicos}
let columns = [];

const DOOR_TYPE_OPTS=[['none','✖ Sem porta'],['mdf','🪵 MDF'],['glass','🔲 Vidro'],['espelho','🪞 Espelho'],['frente','⬜ Frente'],['ripado','〰️ Ripado']];
const BLOCK_DOOR_OPTS=[['none','✖ Aberto'],['mdf','🪵 MDF'],['frente','⬜ Frente'],['ripado','〰️ Ripado']];
const VERT_OPTS=[['baixo','↓ Baixo'],['meio','⬛ Meio'],['cima','↑ Cima']];

const COLORS = [
  '#C47222','#E8942A','#D4A040','#8B5E3C','#F0B878',
  '#BA8545','#A0703A','#D48030','#E0A060','#C09040',
  '#7A5030','#B87030','#906028','#D4C060','#A89040'
];

// ═══════════════════════════════════════════════════════════
// COLUMNS — state + UI
// ═══════════════════════════════════════════════════════════
function defaultColumn(){ return {doorType:'mdf', shelves:0, blocks:[]}; }

function liveColumnWidthMM(idx){
  const W=+document.getElementById('fW').value||800;
  const t=+document.getElementById('thick').value||18;
  const nCols=Math.max(1,+document.getElementById('nCols').value||1);
  const iw=W-2*t;
  const nDiv=nCols-1;
  return Math.round((iw-nDiv*t)/nCols);
}

function setNCols(){
  const n=Math.max(1,Math.min(6,+document.getElementById('nCols').value||1));
  document.getElementById('nCols').value=n;
  while(columns.length<n) columns.push(defaultColumn());
  columns.length=n;
  renderColumns(); scheduleAutoCalc();
}
function addColumn(){
  if(columns.length>=6)return;
  columns.push(defaultColumn());
  document.getElementById('nCols').value=columns.length;
  renderColumns(); scheduleAutoCalc();
}
function removeColumn(ci){
  if(columns.length<=1)return; // sempre precisa de ao menos 1 coluna
  columns.splice(ci,1);
  document.getElementById('nCols').value=columns.length;
  renderColumns(); scheduleAutoCalc();
}

function defaultBlock(kind){
  if(kind==='gaveteiro') return {kind,vertPos:'baixo',qty:2,unitH:300,sentido:'horizontal',doorType:'mdf',depth:0};
  if(kind==='cabideiro') return {kind,vertPos:'cima',nRods:1,unitH:1100};
  if(kind==='sapateira') return {kind,vertPos:'baixo',vaos:4,unitH:800};
  return {kind:'maleiro',vertPos:'cima',unitH:350,doorType:'none'};
}
function addColBlock(ci,kind){
  if(!columns[ci])return;
  columns[ci].blocks.push(defaultBlock(kind));
  renderColumns(); scheduleAutoCalc();
}
function removeColBlock(ci,bi){
  if(!columns[ci])return;
  columns[ci].blocks.splice(bi,1);
  renderColumns(); scheduleAutoCalc();
}
function setColBlockField(ci,bi,key,val){
  if(!columns[ci]||!columns[ci].blocks[bi])return;
  columns[ci].blocks[bi][key]=val;
}
function setColDoor(ci,val){ if(columns[ci]) columns[ci].doorType=val; }
function setColShelves(ci,val){ if(columns[ci]) columns[ci].shelves=Math.max(0,val); }

