// PIECE LIST
// ═══════════════════════════════════════════════════════════
function updatePieces(pieces,cfg){
  const area=document.getElementById('pieceArea');
  const totalQty=pieces.reduce((s,p)=>s+p.qty,0);
  const totalArea=(pieces.reduce((s,p)=>s+p.w*p.h*p.qty,0)/1e6).toFixed(4);
  let html=`<table class="ptable"><thead><tr>
    <th>Peça</th><th>Qtd</th><th>Larg. (mm)</th><th>Alt. (mm)</th><th>Área (m²)</th>
  </tr></thead><tbody>`;
  pieces.forEach(p=>{
    const a=(p.w*p.h*p.qty/1e6).toFixed(4);
    const note=p.name.endsWith('*')?`<span class="opt-tag tag-glass" style="margin-left:4px">${p.name.includes('Espelho')?'Espelho':'Vidro'} (encomenda)</span>`:'';
    html+=`<tr>
      <td><span class="dot" style="background:${p.color}"></span>${p.name}${note}</td>
      <td>${p.qty}×</td><td>${p.w}</td><td>${p.h}</td><td>${a}</td>
    </tr>`;
  });
  html+=`</tbody><tfoot><tr>
    <td><strong>TOTAL</strong></td><td>${totalQty} peças</td>
    <td colspan="2">MDF ${cfg.thick}mm · Kerf ${cfg.kerf}mm</td>
    <td>${totalArea} m²</td>
  </tr></tfoot></table>`;
  if(cfg.cubaPos&&cfg.cubaPos!=='none'){
    const posMap={center:'Centro',left:'Esquerda',right:'Direita'};
    html+=`<div style="margin-top:12px;padding:8px 10px;background:#0F1E28;border:1px solid #1A4860;border-radius:6px;font-size:11px;color:#60B8E0">
      🚰 <strong>Cuba:</strong> Posição ${posMap[cfg.cubaPos]} · ${cfg.cubaW}×${cfg.cubaD||350}mm
      — O tampo será cortado em obra (não incluso na lista de chapas)
    </div>`;
  }
  area.innerHTML=html;
  document.getElementById('exportBar').style.display='flex';
  document.getElementById('exportInfo').textContent=
    `${projectData.sheets.length} chapa(s) · R$ ${(projectData.sheets.length*cfg.price).toFixed(2)}`;
}

