function toggleGroup(name,icon){
  if(!meshGroups[name])return;
  groupVisible[name]=!groupVisible[name];
  meshGroups[name].forEach(m=>m.visible=groupVisible[name]);
  const labels={doors:'portas',drawers:'gavetas',shelves:'prateleiras',cuba:'cuba',maleiro:'maleiro',cabideiro:'cabideiro'};
  const btn=document.getElementById(name+'ToggleBtn');
  if(btn) btn.textContent=icon+' '+(groupVisible[name]?'Ocultar ':'Mostrar ')+labels[name];
  requestShadowUpdate();renderScene();
}

