// THREE.JS — BUILD MODEL
// ═══════════════════════════════════════════════════════════
function update3D(cfg){
  if(!scene){init3D();if(!scene)return;}
  document.getElementById('empty-3d').style.display='none';
  clearMeshes();

  const {type,W,H,D,nCols,columns:cols=[],shelfD:shelfDmm,
         thick,backType,latType,frontType,baseType,legsType,
         legsH:legsHmm,legsW:legsWmm,cubaPos,cubaW,cubaD}=cfg;
  const t=thick;
  const maxDim=Math.max(W,H,D);
  const s=2.4/maxDim;
  currentS=s;

  const wMat=mkMat(0xC47222,1,35), wDark=mkMat(0x8A4E18,1,20);
  const wPanel=mkMat(0xBB7A32,1,30);
  const backMat=mkMat(0xD4B896,1,18), topMat=mkMat(0xD4A040,1,25), kickMat=mkMat(0x7A4A18);
  const rodMat=mkMetalMat(0xBBBBBB);
  const B=meshGroups.base, DA=meshGroups.doors, DR=meshGroups.drawers;
  const SH=meshGroups.shelves, CU=meshGroups.cuba, CA=meshGroups.cabideiro, MA=meshGroups.maleiro;

  // PAINEL RIPADO — caso especial
  if(type==='painel_ripado'){
    const [w,h,d,tk]=[W*s,H*s,D*s,t*s];
    addRipadoSurface(B,0,0,0,w,h,d,0xC47222);
    addBox(B,0,h/2+tk*.4,0,w,tk*.8,d*.3,wDark);
    addBox(B,0,-h/2-tk*.4,0,w,tk*.8,d*.3,wDark);
    addBox(B,-w/2-tk*.4,0,0,tk*.8,h,d*.3,wDark);
    addBox(B,w/2+tk*.4,0,0,tk*.8,h,d*.3,wDark);
    camSph.r=Math.max(2,Math.min(8,Math.max(w,h,d)*2));
    requestShadowUpdate();renderScene();return;
  }

  const isCounter=type==='balcao'||type==='gabinete_banheiro';
  const legsOffset=(legsType==='com')?(legsHmm*s):0;
  const baseH=100*s;
  const [w,fullH,d,tk]=[W*s,H*s,D*s,t*s];
  const kick=isCounter?Math.min(150*s,fullH*0.1):0;
  const bodyH=fullH-kick;
  const iw=w-2*tk, ih=bodyH-2*tk, id=d-tk;
  const effShelfD3d = shelfDmm>0 ? Math.min(shelfDmm*s, id) : id;
  const yOff=legsOffset+(baseType==='com'?baseH:0);
  const bodyCY=yOff+kick+bodyH/2;

  function lat(x,y,z,lw,lh,ld){
    if(latType==='ripado')addRipadoSurface(B,x,y,z,lw,lh,ld,0xC47222);
    else addBox(B,x,y,z,lw,lh,ld,wMat);
  }
  function bk(x,y,z,bw,bh,bd){
    if(backType==='none')return;
    if(backType==='ripado')addRipadoSurface(B,x,y,z,bw,bh,bd,0xC07020);
    else addBox(B,x,y,z,bw,bh,bd,backMat);
  }
  function fr(x,y,z,fw,fh,fd){
    if(frontType==='none')return;
    if(frontType==='ripado') addRipadoSurface(B,x,y,z+fd/2+tk*.15,fw,fh,tk*.3,0xC47222);
    else addBox(B,x,y,z+fd/2+tk*.1,fw,fh,tk*.25,mkMat(0xD4B896,0.85,30));
  }
  function addLegs(botY,fw,fd){
    if(legsType!=='com')return;
    const legH=legsHmm*s, legW=legsWmm*s;
    const lMat=mkMat(0x4A3020,1,60);
    const ox=(fw/2-legW), oz=(fd/2-legW);
    [[-ox,-oz],[ox,-oz],[-ox,oz],[ox,oz]].forEach(([lx,lz])=>{
      addBox(B,lx,botY-legH/2,lz,legW,legH,legW,lMat);
    });
  }
  function addBase(botY,fw,fd){
    if(baseType!=='com')return;
    addBox(B,0,botY-baseH/2,0,fw,baseH,fd,mkMat(0x6A3C15,1,15));
  }

  lat(-w/2+tk/2,bodyCY,0,tk,bodyH,d); lat(w/2-tk/2,bodyCY,0,tk,bodyH,d);
  addBox(B,0,bodyCY+bodyH/2-tk/2,0,iw,tk,d,isCounter?mkMat(type==='gabinete_banheiro'?0xF5F5F5:0xE8D4B0,1,30):topMat);
  addBox(B,0,bodyCY-bodyH/2+tk/2,0,iw,tk,d,wDark);
  bk(0,bodyCY,-d/2+tk*.12,w,bodyH,tk*.28);
  fr(0,bodyCY,0,iw,ih,d);
  if(isCounter) addBox(B,0,yOff+kick/2,d/2-tk*.4,iw,kick,tk*.8,kickMat);

  const nDiv=Math.max(0,nCols-1);
  const colW = nCols>0 ? (iw-nDiv*tk)/nCols : iw;
  const intBotY=bodyCY-ih/2;
  for(let i=1;i<=nDiv;i++){
    const x=-iw/2+i*(colW+tk)-tk/2;
    addBox(B,x,bodyCY,0,tk,ih,id,wDark);
  }

  // Gaveteiro block renderer
  function addGaveteiroBlock3D(colCX,baseY,blockH,colWd,idScene,b){
    const qty=Math.max(1,b.qty||1), sentido=b.sentido||'horizontal', dt=b.doorType||'mdf';
    const depMM=b.depth||0;
    const effD=depMM>0?Math.min(depMM*s,idScene):idScene-10*s;
    if(sentido==='vertical'&&qty>1){
      const sW=colWd/qty;
      for(let i=0;i<qty;i++){
        const dx=colCX-colWd/2+sW/2+i*sW;
        addDrawerUnit(B,DA,DR,dx,baseY+blockH/2,0,sW,blockH,effD,tk,dt);
      }
    } else {
      const perH=blockH/qty;
      for(let i=0;i<qty;i++){
        const dy=baseY+perH/2+i*(perH+tk*0.1);
        addDrawerUnit(B,DA,DR,colCX,dy,0,colWd,perH,effD,tk,dt);
      }
    }
  }
  // Cabideiro block renderer
  function addCabideiroBlock3D(colCX,baseY,blockH,colWd,idScene,b){
    const nRods=Math.max(1,b.nRods||1);
    const topShelfY=baseY+blockH;
    const effShelf=Math.min(effShelfD3d,idScene);
    addBox(CA,colCX,topShelfY,-(idScene-effShelf)/2,colWd,tk,effShelf,wPanel);
    // Barra fixa a 10cm do topo do bloco (seja o teto do armário ou a base de um maleiro acima)
    const ROD_DROP_MM=100;
    const rodY=Math.max(baseY+tk*0.5, topShelfY-ROD_DROP_MM*s);
    if(nRods>1){
      const cW=colWd/nRods;
      for(let i=1;i<nRods;i++) addBox(CA,colCX-colWd/2+cW*i,baseY+blockH/2,0,tk,blockH,idScene,wDark);
      for(let i=0;i<nRods;i++){
        const rx=colCX-colWd/2+cW*(i+.5);
        addBox(CA,rx,rodY,0,cW-tk*2,tk*0.4,tk*0.4,rodMat);
      }
    } else {
      addBox(CA,colCX,rodY,0,colWd-tk*2,tk*0.4,tk*0.4,rodMat);
    }
  }
  // Maleiro block renderer
  function addMaleiroBlock3D(colCX,baseY,blockH,colWd,idScene,dScene,b){
    const dt=b.doorType||'none';
    const midY=baseY+blockH/2;
    addBox(MA,colCX,baseY,0,colWd,tk,idScene,wDark);
    addBox(MA,colCX,midY,-idScene*0.45,colWd-tk*0.1,blockH,tk*0.4,mkMat(0x7A5228,1,8));
    if(dt!=='none') addDoor(MA,colCX,midY,dScene/2+tk*.55,colWd,blockH,dt);
  }
  // Sapateira — divide a altura do bloco em N vãos iguais, com prateleiras entre eles
  function addSapateiraBlock3D(colCX,baseY,blockH,colWd,idScene,b){
    const vaos=Math.max(1,b.vaos||1);
    const vaoH=blockH/vaos;
    addBox(SH,colCX,baseY,0,colWd,tk,idScene,wDark); // base do bloco
    for(let i=1;i<vaos;i++){
      addBox(SH,colCX,baseY+vaoH*i,0,colWd,tk,idScene,wPanel);
    }
    addBox(SH,colCX,baseY+blockH,0,colWd,tk,idScene,wDark); // topo do bloco
  }

  // Build each column independently — fixes door/gaveteiro mismatch bugs
  for(let c=0;c<nCols;c++){
    const col=cols[c]||defaultColumn();
    const colCX=-iw/2+c*(colW+tk)+colW/2;
    const items=sortBlocksMaleiroFirst((col.blocks||[]).map(b=>{
      let hMM=b.kind==='gaveteiro'?(b.unitH||300):b.kind==='cabideiro'?(b.unitH||1100):(b.unitH||350);
      const hScene=Math.min(hMM*s, ih*0.92);
      // Maleiro fica sempre no topo absoluto da coluna, nunca é editável
      return {b, h:hScene, vertPos: b.kind==='maleiro' ? 'cima' : (b.vertPos||'baixo')};
    }));
    const {placements,freeStart,freeEnd}=layoutColumn(items, ih, tk);

    placements.forEach(p=>{
      const baseY=intBotY+p.y0, blockH=p.y1-p.y0;
      if(p.b.kind==='gaveteiro') addGaveteiroBlock3D(colCX,baseY,blockH,colW,id,p.b);
      else if(p.b.kind==='cabideiro') addCabideiroBlock3D(colCX,baseY,blockH,colW,id,p.b);
      else if(p.b.kind==='sapateira') addSapateiraBlock3D(colCX,baseY,blockH,colW,id,p.b);
      else if(p.b.kind==='maleiro') addMaleiroBlock3D(colCX,baseY,blockH,colW,id,d,p.b);
    });

    // Porta da coluna: SEMPRE cobre a coluna inteira (piso ao teto), na frente de tudo —
    // esconde gaveteiro/cabideiro/maleiro atrás dela, como um armário de porta batente.
    const dt=col.doorType||'mdf';
    if(dt!=='none') addDoor(DA,colCX,bodyCY,d/2+tk*0.55,colW,ih,dt);

    // Prateleiras continuam só no vão livre (onde não há gaveteiro/cabideiro/maleiro)
    const freeH=freeEnd-freeStart;
    const shelves=col.shelves||0;
    if(freeH>tk && shelves>0){
      const effShelf=Math.min(effShelfD3d,id);
      for(let i=1;i<=shelves;i++){
        const y=intBotY+freeStart+(freeH/(shelves+1))*i;
        addBox(SH,colCX,y,-(id-effShelf)/2,colW,tk,effShelf,wPanel);
      }
    }
  }

  // Cuba / Sink (balcão / gabinete banheiro)
  if(isCounter && cubaPos && cubaPos!=='none' && cubaW>0){
    const counterTopY=bodyCY+bodyH/2-tk/2;
    addSink(CU,counterTopY,iw,id,cubaW,cubaD||350,cubaPos,s);
    document.getElementById('cubaToggleBtn').style.display='';
  }

  addLegs(yOff,w,d); addBase(yOff,w,d);
  camSph.r=Math.max(2.5,Math.min(9,Math.max(w,fullH,d)*2.2));
  requestShadowUpdate();renderScene();
}

