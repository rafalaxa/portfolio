function mkMat(color,opacity=1,shin=28){
  return new THREE.MeshPhongMaterial({color,shininess:shin,specular:0x181008,transparent:opacity<1,opacity});
}
function mkGlassMat(tint=0xB8D8F0,op=0.28){
  return new THREE.MeshPhongMaterial({color:tint,shininess:180,specular:0xFFFFFF,transparent:true,opacity:op,side:THREE.DoubleSide});
}
function mkMetalMat(color=0xAAAAAA){
  return new THREE.MeshPhongMaterial({color,shininess:90,specular:0xEEEEEE});
}
function mkCeramicMat(color=0xF0F4F8){
  return new THREE.MeshPhongMaterial({color,shininess:120,specular:0xDDEEFF});
}
function addBox(grp,x,y,z,w,h,d,mat){
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
  m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;
  scene.add(m);grp.push(m);return m;
}
function clearMeshes(){
  Object.values(meshGroups).flat().forEach(m=>{scene.remove(m);if(m.geometry)m.geometry.dispose();if(m.material&&m.material.dispose)m.material.dispose();});
  meshGroups={base:[],doors:[],drawers:[],shelves:[],cuba:[],maleiro:[],cabideiro:[]};
  groupVisible={doors:true,drawers:true,shelves:true,cuba:true,maleiro:true,cabideiro:true};
  hoveredMesh=null; selectedMesh=null;
  if(hoverBoxMesh)hoverBoxMesh.visible=false;
  if(selectBoxMesh)selectBoxMesh.visible=false;
  document.getElementById('edit3d-panel').style.display='none';
  document.getElementById('hover3d-label').style.display='none';
  ['doorToggleBtn','drawerToggleBtn','shelfToggleBtn'].forEach(id=>{
    const el=document.getElementById(id);
    if(el){const txt=el.textContent;el.textContent=txt.replace('Mostrar','Ocultar');}
  });
}
function addRipadoSurface(grp,cx,cy,cz,w,h,depth,col){
  const ripaW=Math.max(depth*0.85,w*0.032);
  const gap=ripaW*0.38;
  const step=ripaW+gap;
  const nR=Math.max(1,Math.round(w/step));
  const totalW=nR*step-gap;
  addBox(grp,cx,cy,cz-depth*0.5,w,h,depth*0.22,mkMat(col-0x202020));
  for(let i=0;i<nR;i++){
    addBox(grp,cx-totalW/2+ripaW/2+i*step,cy,cz,ripaW,h,depth,mkMat(col,1,18));
  }
}
function addDoor(DA,dx,doorCY,doorDZ,dw,dh,doorType){
  const gap=dw*0.012, th=dh*0.012;
  if(doorType==='glass'){
    addBox(DA,dx,doorCY,doorDZ,dw-gap,dh,th*0.5,mkGlassMat());
    addBox(DA,dx,doorCY+dh/2-th*0.6,doorDZ,dw-gap,th*1.1,th*0.5,mkMat(0x909090));
    addBox(DA,dx,doorCY-dh/2+th*0.6,doorDZ,dw-gap,th*1.1,th*0.5,mkMat(0x909090));
    addBox(DA,dx-dw/2+th*0.9,doorCY,doorDZ,th*1.1,dh,th*0.5,mkMat(0x909090));
    addBox(DA,dx+dw/2-th*0.9,doorCY,doorDZ,th*1.1,dh,th*0.5,mkMat(0x909090));
  } else if(doorType==='espelho'){
    addBox(DA,dx,doorCY,doorDZ,dw-gap,dh,th*0.5,mkMat(0xC8D4DC,0.92,150));
    addBox(DA,dx,doorCY+dh/2-th*0.6,doorDZ,dw-gap,th*1.1,th*0.5,mkMat(0x909090));
    addBox(DA,dx,doorCY-dh/2+th*0.6,doorDZ,dw-gap,th*1.1,th*0.5,mkMat(0x909090));
    addBox(DA,dx-dw/2+th*0.9,doorCY,doorDZ,th*1.1,dh,th*0.5,mkMat(0x909090));
    addBox(DA,dx+dw/2-th*0.9,doorCY,doorDZ,th*1.1,dh,th*0.5,mkMat(0x909090));
  } else if(doorType==='ripado'){
    addRipadoSurface(DA,dx,doorCY,doorDZ-th*0.5,dw-gap,dh,th*1.2,0xC47222);
  } else if(doorType==='frente'){
    addBox(DA,dx,doorCY,doorDZ,dw-gap,dh,th,mkMat(0xD8C09A,1,55));
    addBox(DA,dx,doorCY-dh*0.4,doorDZ+th*0.55,dw*0.45,th*0.6,th*0.3,mkMat(0x9A7850));
  } else {
    const hSide=(DA.length%2===0)?1:-1;
    addBox(DA,dx,doorCY,doorDZ,dw-gap,dh,th,mkMat(0x8B5532,0.9,42));
    addBox(DA,dx+dw*0.33*hSide,doorCY,doorDZ+th*0.9,dw*0.04,dh*0.12,th*1.2,mkMetalMat());
  }
}
function addDrawerUnit(B,DA,DR,cx,cy,cz,dw,dh,dd,tk,doorType){
  addBox(DR,cx,cy,cz-dd*0.06,dw-tk*0.18,dh-tk*0.22,dd*0.82,mkMat(0x6A3C15));
  addBox(DR,cx-dw*0.49,cy,cz,tk*0.1,tk*0.18,dd,mkMetalMat(0x909090));
  addBox(DR,cx+dw*0.49,cy,cz,tk*0.1,tk*0.18,dd,mkMetalMat(0x909090));
  const fz=cz+dd/2+tk*0.12;
  if(doorType==='glass'){
    addBox(DA,cx,cy,fz,dw-tk*.06,dh,tk*.75,mkGlassMat(0xC0E8F0,0.35));
    addBox(DA,cx,cy+dh/2-tk*.1,fz,dw-tk*.06,tk*.18,tk*.75,mkMat(0x888888));
    addBox(DA,cx,cy-dh/2+tk*.1,fz,dw-tk*.06,tk*.18,tk*.75,mkMat(0x888888));
    addBox(DA,cx-dw/2+tk*.15,cy,fz,tk*.18,dh,tk*.75,mkMat(0x888888));
    addBox(DA,cx+dw/2-tk*.15,cy,fz,tk*.18,dh,tk*.75,mkMat(0x888888));
  } else if(doorType==='ripado'){
    addRipadoSurface(DA,cx,cy,fz,dw-tk*.06,dh,tk*0.8,0xC47222);
  } else if(doorType==='frente'){
    addBox(DA,cx,cy,fz,dw-tk*.06,dh,tk*0.85,mkMat(0xD4B896,1,50));
    addBox(DA,cx,cy-dh*0.38,fz+tk*0.45,dw*0.32,tk*0.1,tk*0.06,mkMat(0x9A7850));
  } else {
    addBox(DA,cx,cy,fz,dw-tk*.06,dh,tk*0.85,mkMat(0xC47222,1,38));
    addBox(DA,cx,cy,fz+tk*0.5,dw*0.3,tk*0.15,tk*0.22,mkMetalMat(0xBBBBBB));
  }
}
function addSink(cubaGrp,counterTopY,innerW,innerD,cubaWmm,cubaDmm,cubaPosSt,s){
  const cW=Math.min(cubaWmm*s,innerW*0.9);
  const cDep=Math.min(cubaDmm*s,innerD*0.88);
  const cH=Math.min(0.18,cubaWmm*s*0.35);
  let sinkX=0;
  if(cubaPosSt==='left') sinkX=-innerW/2+cW/2+0.018;
  if(cubaPosSt==='right') sinkX=innerW/2-cW/2-0.018;
  addBox(cubaGrp,sinkX,counterTopY-cH/2,0,cW,cH,cDep,mkCeramicMat(0xEEF2F8));
  addBox(cubaGrp,sinkX,counterTopY-cH+0.005,-0.002,cW*0.88,0.008,cDep*0.86,mkCeramicMat(0xD0D8E8));
  addBox(cubaGrp,sinkX,counterTopY-cH+0.003,0,0.018,0.005,0.018,mkMetalMat(0x888888));
  const fZ=-innerD*0.28;
  const fH=cH*0.8+0.04;
  addBox(cubaGrp,sinkX,counterTopY+fH/2,fZ,0.012,fH,0.012,mkMetalMat(0xC8C8C8));
  addBox(cubaGrp,sinkX,counterTopY+fH+0.012,fZ+innerD*0.08,0.012,0.012,innerD*0.16,mkMetalMat(0xC8C8C8));
  addBox(cubaGrp,sinkX-cW*0.28,counterTopY+fH*0.7,fZ,0.03,0.010,0.010,mkMetalMat(0xC8C8C8));
  addBox(cubaGrp,sinkX+cW*0.28,counterTopY+fH*0.7,fZ,0.03,0.010,0.010,mkMetalMat(0xC8C8C8));
}

