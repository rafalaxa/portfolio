function init3D(){
  const canvas=document.getElementById('canvas3d');
  if(!canvas.clientWidth)return;
  renderer=new THREE.WebGLRenderer({canvas,antialias:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.shadowMap.enabled=true;
  renderer.shadowMap.type=THREE.PCFSoftShadowMap;
  renderer.shadowMap.autoUpdate=false; // sombra só recalcula quando o modelo muda, não a cada frame de câmera
  renderer.physicallyCorrectLights=true;
  scene=new THREE.Scene();
  scene.background=new THREE.Color(0x0C0C18);
  scene.fog=new THREE.FogExp2(0x0C0C18,0.025);
  const asp=canvas.clientWidth/canvas.clientHeight;
  camera=new THREE.PerspectiveCamera(40,asp,0.01,200);
  resizeRenderer();

  scene.add(new THREE.AmbientLight(0xFFEED0,0.38));
  const sun=new THREE.DirectionalLight(0xFFF5E0,1.3);
  sun.position.set(5,10,7);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);
  sun.shadow.camera.near=0.1;sun.shadow.camera.far=50;scene.add(sun);
  const fill=new THREE.DirectionalLight(0xB0C8FF,0.28);fill.position.set(-6,4,-5);scene.add(fill);
  const rim=new THREE.DirectionalLight(0xFFD8A0,0.18);rim.position.set(0,2,-8);scene.add(rim);
  const floorGeo=new THREE.PlaneGeometry(20,20);
  const floorMat=new THREE.MeshPhongMaterial({color:0x151520,shininess:8,specular:0x111122});
  const floor=new THREE.Mesh(floorGeo,floorMat);
  floor.rotation.x=-Math.PI/2;floor.position.y=-0.005;floor.receiveShadow=true;scene.add(floor);
  const grid=new THREE.GridHelper(18,36,0x1E1E32,0x191928);grid.position.y=0.001;scene.add(grid);
  raycaster3d=new THREE.Raycaster();
  mouse3d=new THREE.Vector2();

  canvas.addEventListener('mousedown',e=>{isDrag=true;prevMouse={x:e.clientX,y:e.clientY};});
  window.addEventListener('mouseup',()=>isDrag=false);
  canvas.addEventListener('mousemove',e=>{
    if(!isDrag)return;
    camSph.theta-=(e.clientX-prevMouse.x)*0.007;
    camSph.phi=clamp(camSph.phi-(e.clientY-prevMouse.y)*0.007,0.05,Math.PI/2-0.05);
    prevMouse={x:e.clientX,y:e.clientY};renderScene();
  });
  canvas.addEventListener('wheel',e=>{camSph.r=clamp(camSph.r+e.deltaY*0.004,1.2,18);renderScene();},{passive:true});

  let lt=null;
  canvas.addEventListener('touchstart',e=>{isDrag=true;lt={x:e.touches[0].clientX,y:e.touches[0].clientY};},{passive:true});
  canvas.addEventListener('touchmove',e=>{
    if(!isDrag||!lt)return;e.preventDefault();
    camSph.theta-=(e.touches[0].clientX-lt.x)*0.009;
    camSph.phi=clamp(camSph.phi-(e.touches[0].clientY-lt.y)*0.009,0.05,Math.PI/2-0.05);
    lt={x:e.touches[0].clientX,y:e.touches[0].clientY};renderScene();
  },{passive:false});
  canvas.addEventListener('touchend',()=>{isDrag=false;lt=null;});

  hoverBoxMesh=makeHighlightBox(0xFFC862,0.30);
  selectBoxMesh=makeHighlightBox(0xFF9A30,0.42);
  let lastHoverTime=0;
  canvas.addEventListener('mousemove',e=>{
    if(isDrag)return;
    const now=Date.now();if(now-lastHoverTime<40)return;lastHoverTime=now;
    const rect=canvas.getBoundingClientRect();
    mouse3d.x=((e.clientX-rect.left)/rect.width)*2-1;
    mouse3d.y=-((e.clientY-rect.top)/rect.height)*2+1;
    raycaster3d.setFromCamera(mouse3d,camera);
    const allMeshes=Object.values(meshGroups).flat().filter(m=>m.visible&&m.isMesh);
    const hits=raycaster3d.intersectObjects(allMeshes);
    const label=document.getElementById('hover3d-label');
    if(hits.length>0){
      const m=hits[0].object;
      hoveredMesh=m;
      if(m!==selectedMesh) fitHighlight(hoverBoxMesh,m); else hoverBoxMesh.visible=false;
      canvas.style.cursor='pointer';
      label.style.display='block';
      label.style.left=(e.clientX-rect.left+12)+'px';
      label.style.top=(e.clientY-rect.top-22)+'px';
      label.textContent=getGroupLabel(m);
      renderScene();
    } else {
      hoveredMesh=null;
      hoverBoxMesh.visible=false;
      canvas.style.cursor=isDrag?'grabbing':'grab';
      label.style.display='none';
      renderScene();
    }
  });

  canvas.addEventListener('click',e=>{
    if(Math.abs(e.movementX)+Math.abs(e.movementY)>5)return;
    const rect=canvas.getBoundingClientRect();
    mouse3d.x=((e.clientX-rect.left)/rect.width)*2-1;
    mouse3d.y=-((e.clientY-rect.top)/rect.height)*2+1;
    raycaster3d.setFromCamera(mouse3d,camera);
    const allMeshes=Object.values(meshGroups).flat().filter(m=>m.visible&&m.isMesh);
    const hits=raycaster3d.intersectObjects(allMeshes);
    selectedMesh=null;
    selectBoxMesh.visible=false;
    if(hits.length>0){
      const m=hits[0].object;
      selectedMesh=m;
      fitHighlight(selectBoxMesh,m);
      hoverBoxMesh.visible=false;
      showEdit3D(m);
      renderScene();
    } else {
      document.getElementById('edit3d-panel').style.display='none';
      renderScene();
    }
  });

  renderScene();
}

function makeHighlightBox(color,opacity){
  const geo=new THREE.BoxGeometry(1,1,1);
  const mat=new THREE.MeshBasicMaterial({color,transparent:true,opacity,depthWrite:false});
  const m=new THREE.Mesh(geo,mat);
  m.visible=false;m.renderOrder=10;
  scene.add(m);
  return m;
}
function fitHighlight(box,mesh){
  const p=mesh.geometry.parameters||{};
  box.position.copy(mesh.position);
  box.rotation.copy(mesh.rotation);
  box.scale.set(Math.max(p.width||0.001,0.001)*1.05,Math.max(p.height||0.001,0.001)*1.05,Math.max(p.depth||0.001,0.001)*1.05);
  box.visible=true;
}
function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}
function resizeRenderer(){
  const c=document.getElementById('canvas3d');
  if(!renderer||!camera||!c.clientWidth)return;
  renderer.setSize(c.clientWidth,c.clientHeight);
  camera.aspect=c.clientWidth/c.clientHeight;
  camera.updateProjectionMatrix();
}
window.addEventListener('resize',()=>{resizeRenderer();renderScene();});

function renderScene(){
  if(!renderer||!scene||!camera)return;
  const {theta,phi,r}=camSph;
  camera.position.set(r*Math.sin(phi)*Math.sin(theta),r*Math.cos(phi),r*Math.sin(phi)*Math.cos(theta));
  camera.lookAt(0,0,0);
  renderer.render(scene,camera);
}
function requestShadowUpdate(){ if(renderer) renderer.shadowMap.needsUpdate=true; }
function resetCam(){camSph={theta:0.75,phi:0.48,r:5};renderScene();}

