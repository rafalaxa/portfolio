// CUTTING MAP
// ═══════════════════════════════════════════════════════════
function updateMap(sheets,cfg){
  const area=document.getElementById('mapArea');
  area.innerHTML='';
  sheets.forEach((sh,idx)=>{
    const eff=sh.efficiency();
    const div=document.createElement('div');
    div.className='sheet-card';
    const ec=eff>75?'var(--ok)':eff>50?'var(--warn)':'var(--err)';
    div.innerHTML=`
      <div class="sheet-hdr">
        <div class="sheet-title">Chapa ${idx+1} de ${sheets.length}</div>
        <div class="sheet-meta">
          <span>📐 ${cfg.sw}×${cfg.sh}mm</span>
          <span>🧩 ${sh.placed.length} peças</span>
          <span style="color:${ec}">♻️ ${eff}% aproveitado</span>
        </div>
      </div>
      <div class="eff-bar"><div class="eff-fill" style="width:${eff}%;background:${ec}"></div></div>
    `;
    const canvas=document.createElement('canvas');
    canvas.className='map-canvas';
    div.appendChild(canvas);
    area.appendChild(div);
    drawSheet(canvas,sh,cfg);
  });
}
function drawSheet(canvas,sh,cfg){
  const pad=16;
  const contW=canvas.parentElement.clientWidth-28;
  const sc=(contW-pad*2)/cfg.sw;
  canvas.width=Math.round(cfg.sw*sc+pad*2);
  canvas.height=Math.round(cfg.sh*sc+pad*2);
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#14142A';ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#C8A878';ctx.fillRect(pad,pad,cfg.sw*sc,cfg.sh*sc);
  ctx.strokeStyle='rgba(160,110,60,.15)';ctx.lineWidth=1;
  for(let y=30;y<cfg.sh;y+=60){ctx.beginPath();ctx.moveTo(pad,pad+y*sc);ctx.lineTo(pad+cfg.sw*sc,pad+y*sc);ctx.stroke();}
  ctx.strokeStyle='#886040';ctx.lineWidth=2;ctx.strokeRect(pad,pad,cfg.sw*sc,cfg.sh*sc);
  sh.placed.forEach(p=>{
    const x=pad+p.x*sc,y=pad+p.y*sc,pw=p.w*sc,ph=p.h*sc;
    ctx.fillStyle=p.color+'CC';ctx.fillRect(x+1,y+1,pw-2,ph-2);
    if(p.rotated){ctx.fillStyle='rgba(255,255,255,.1)';ctx.fillRect(x+1,y+1,pw-2,ph-2);}
    ctx.strokeStyle=p.color;ctx.lineWidth=1.5;ctx.strokeRect(x+1,y+1,pw-2,ph-2);
    if(pw>22&&ph>14){
      const fs=clamp(Math.min(pw,ph)*.18,6,12);
      ctx.fillStyle='rgba(0,0,0,.82)';ctx.font=`bold ${fs}px 'Segoe UI',sans-serif`;
      ctx.textAlign='center';ctx.textBaseline='middle';
      if(ph>fs*2.5){
        ctx.fillText((p.rotated?'↻':'')+p.name,x+pw/2,y+ph/2-fs*.55);
        ctx.font=`${fs*.8}px 'Segoe UI',sans-serif`;ctx.fillStyle='rgba(0,0,0,.6)';
        ctx.fillText(`${p.w}×${p.h}`,x+pw/2,y+ph/2+fs*.7);
      } else ctx.fillText((p.rotated?'↻':'')+p.name,x+pw/2,y+ph/2);
    }
  });
  ctx.fillStyle='#6868A0';ctx.font='10px monospace';ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillText(cfg.sw+'mm',pad+4,pad+4);
  ctx.save();ctx.translate(pad+4,pad+cfg.sh*sc-4);ctx.rotate(-Math.PI/2);ctx.fillText(cfg.sh+'mm',0,0);ctx.restore();
}

