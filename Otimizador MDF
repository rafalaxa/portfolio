function updatePanelTags(cfg){
  const tags=[];
  const bMap={mdf:'Fundo liso',ripado:'Fundo ripado',none:'Sem fundo'};
  const lMap={mdf:'Lat. lisa',ripado:'Lat. ripado'};
  const fMap={none:'Sem frente',mdf:'Frente MDF',ripado:'Frente Ripado'};
  const dMap={none:'✖ Aberta',mdf:'🪵 MDF',frente:'⬜ Frente',glass:'🔲 Vidro',espelho:'🪞 Espelho',ripado:'〰️ Ripado'};
  tags.push(`<span class="opt-tag ${cfg.backType==='none'?'tag-none':cfg.backType==='ripado'?'tag-ripado':'tag-default'}">${bMap[cfg.backType]}</span>`);
  tags.push(`<span class="opt-tag ${cfg.latType==='ripado'?'tag-ripado':'tag-default'}">${lMap[cfg.latType]}</span>`);
  if(cfg.frontType&&cfg.frontType!=='none') tags.push(`<span class="opt-tag ${cfg.frontType==='ripado'?'tag-ripado':'tag-default'}">${fMap[cfg.frontType]}</span>`);
  (cfg.columns||[]).forEach((col,idx)=>{
    const parts=[`Col.${idx+1}: ${dMap[col.doorType]||col.doorType}`];
    if(col.shelves>0) parts.push(`${col.shelves}prat.`);
    (col.blocks||[]).forEach(b=>{
      if(b.kind==='gaveteiro') parts.push(`🗄${b.qty}×${Math.round((b.unitH||300)/Math.max(1,b.qty))}mm`);
      if(b.kind==='cabideiro') parts.push(`👔${b.unitH}mm`);
      if(b.kind==='maleiro') parts.push(`🧳${b.unitH}mm`);
      if(b.kind==='sapateira') parts.push(`👞${b.vaos}vãos×${Math.round((b.unitH||800)/Math.max(1,b.vaos||1))}mm`);
    });
    tags.push(`<span class="opt-tag tag-default">${parts.join(' · ')}</span>`);
  });
  if(cfg.baseType==='com') tags.push(`<span class="opt-tag tag-default">🔲 Com Base</span>`);
  if(cfg.legsType==='com') tags.push(`<span class="opt-tag tag-default">🦵 Pezinhos ${cfg.legsH}×${cfg.legsW}mm</span>`);
  if(cfg.cubaPos&&cfg.cubaPos!=='none') tags.push(`<span class="opt-tag tag-cuba">🚰 Cuba ${cfg.cubaPos==='center'?'centro':cfg.cubaPos==='left'?'esq.':'dir.'} ${cfg.cubaW}mm</span>`);
  document.getElementById('panelTags').innerHTML=tags.join('');
}

